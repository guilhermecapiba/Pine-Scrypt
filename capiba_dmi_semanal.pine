//@version=6
indicator(title="Capiba DMI Semanal+", shorttitle="Capiba DMI Semanal+", format=format.price, precision=4)

TT_ADX_LEN = "The time period to be used in calculating the ADX which has a smoothing component."
TT_DI_LEN  = "The time period to be used in calculating the DI (Directional Indicator)."

lensig = input.int(12, "ADX Smoothing", minval = 1, tooltip = TT_ADX_LEN)
len =    input.int(12, "DI Length",     minval = 1, tooltip = TT_DI_LEN)

up = ta.change(high)
down = -ta.change(low)
plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
trur = ta.rma(ta.tr, len)
plus = fixnan(100 * ta.rma(plusDM, len) / trur)
minus = fixnan(100 * ta.rma(minusDM, len) / trur)
sum = plus + minus
adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), lensig)

plot(adx, color=color.white, title="ADX", linewidth=4)
plot(plus, color=color.green, title="+DI", linewidth=2)
plot(minus, color=color.red, title="-DI", linewidth=2)

// --- ADX Direction Signals ---
var int adx_dir = 0 // 1 for rising, -1 for falling
bool plot_green = false
bool plot_red = false

if not na(adx) and not na(adx[1])
    if adx > adx[1]
        if adx_dir != 1
            plot_green := true
            adx_dir := 1
    else if adx < adx[1]
        if adx_dir != -1
            plot_red := true
            adx_dir := -1

plotshape(plot_green ? adx : na, title="ADX Subindo", style=shape.arrowup, location=location.absolute, color=color.green, size=size.small)
plotshape(plot_red ? adx : na, title="ADX Caindo", style=shape.arrowdown, location=location.absolute, color=color.red, size=size.small)

// Divergence Logic (Capiba style)
prd = input.int(5, title="Pivot Period", minval=1)

// Function to find pivots and detect divergences
detect_divergences(src, is_plus_di) =>
    float ph = ta.pivothigh(src, prd, prd)
    float pl = ta.pivotlow(src, prd, prd)

    // Keep track of previous pivots
    var float prev_ph = na
    var float prev_ph_price = na
    var int prev_ph_bar = na

    var float prev_pl = na
    var float prev_pl_price = na
    var int prev_pl_bar = na

    bool bull_div = false
    bool bear_div = false

    // Check for Lower High / Higher High in Peaks (Bearish Divergence)
    if not na(ph)
        if not na(prev_ph) and not na(prev_ph_price)
            if is_plus_di
                // +DI Bearish: Price Higher High, +DI Lower High
                if high[prd] > prev_ph_price and src[prd] < prev_ph
                    bear_div := true
            else
                // -DI Bullish: Price Lower Low, -DI Lower High (Less selling pressure on Lower Lows)
                // Note: -DI goes UP when price goes DOWN.
                // A lower peak in -DI when price makes a lower low is a BULLISH divergence.
                // At a -DI peak, we track the price LOW. We compare it to the PREVIOUS price LOW at a -DI peak (prev_ph_price).
                if low[prd] < prev_ph_price and src[prd] < prev_ph
                    bull_div := true

        prev_ph := src[prd]
        // If it's -DI, its peaks correspond to price troughs, so we track price low
        prev_ph_price := is_plus_di ? high[prd] : low[prd]
        prev_ph_bar := bar_index[prd]

    // Check for Higher Low / Lower Low in Troughs (Bullish Divergence)
    if not na(pl)
        if not na(prev_pl) and not na(prev_pl_price)
            if is_plus_di
                // +DI Bullish: Price Lower Low, +DI Higher Low
                if low[prd] < prev_pl_price and src[prd] > prev_pl
                    bull_div := true
            else
                // -DI Bearish: Price Higher High, -DI Higher Low (More selling pressure underlying a Higher High)
                // Note: A higher trough in -DI when price makes a higher high is a BEARISH divergence.
                // At a -DI trough, we track the price HIGH. We compare it to the PREVIOUS price HIGH at a -DI trough (prev_pl_price).
                if high[prd] > prev_pl_price and src[prd] > prev_pl
                    bear_div := true

        prev_pl := src[prd]
        // If it's -DI, its troughs correspond to price peaks, so we track price high
        prev_pl_price := is_plus_di ? low[prd] : high[prd]
        prev_pl_bar := bar_index[prd]

    [bull_div, bear_div, prev_ph_bar, prev_pl_bar, prev_ph, prev_pl]

[plus_bull, plus_bear, plus_prev_ph_bar, plus_prev_pl_bar, plus_prev_ph, plus_prev_pl] = detect_divergences(plus, true)
[minus_bull, minus_bear, minus_prev_ph_bar, minus_prev_pl_bar, minus_prev_ph, minus_prev_pl] = detect_divergences(minus, false)

// Plot +DI Divergences
plotshape(plus_bull ? plus[prd] : na, title="+DI Bullish Div", style=shape.labelup, location=location.absolute, color=color.green, text="Bull", textcolor=color.white, offset=-prd)
plotshape(plus_bear ? plus[prd] : na, title="+DI Bearish Div", style=shape.labeldown, location=location.absolute, color=color.red, text="Bear", textcolor=color.white, offset=-prd)

if plus_bull
    line.new(plus_prev_pl_bar, plus_prev_pl, bar_index[prd], plus[prd], color=color.green, style=line.style_dotted, width=2)
if plus_bear
    line.new(plus_prev_ph_bar, plus_prev_ph, bar_index[prd], plus[prd], color=color.red, style=line.style_dotted, width=2)

// Plot -DI Divergences
plotshape(minus_bull ? minus[prd] : na, title="-DI Bullish Div", style=shape.labelup, location=location.absolute, color=color.green, text="Bull", textcolor=color.white, offset=-prd)
plotshape(minus_bear ? minus[prd] : na, title="-DI Bearish Div", style=shape.labeldown, location=location.absolute, color=color.red, text="Bear", textcolor=color.white, offset=-prd)

if minus_bull
    line.new(minus_prev_ph_bar, minus_prev_ph, bar_index[prd], minus[prd], color=color.green, style=line.style_dotted, width=2) // Bullish div for -DI connects peaks
if minus_bear
    line.new(minus_prev_pl_bar, minus_prev_pl, bar_index[prd], minus[prd], color=color.red, style=line.style_dotted, width=2) // Bearish div for -DI connects troughs
