//@version=5
indicator("Capiba SMC: Unicorn & AMD [Desbloqueando Smart Money]", shorttitle="Capiba SMC", overlay=true, max_bars_back=500, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
// CONFIGURAÇÕES E INPUTS
// -----------------------------------------------------------------------------
grp_struc = "Estrutura de Mercado"
len = input.int(5, "Comprimento do Pivot", group=grp_struc)
show_bos = input.bool(true, "Mostrar BOS (Continuidade)", group=grp_struc)
show_choch = input.bool(true, "Mostrar CHoCH (Inversão)", group=grp_struc)
sz_bos_choch_input = input.string("Tiny", "Tamanho do Texto (BOS/CHoCH)", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_struc)
show_sweep = input.bool(true, "Mostrar SWEEPS (Captura de Liquidez)", group=grp_struc)
sz_sweep_input = input.string("Tiny", "Tamanho do Texto (SWEEP)", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_struc)

grp_uni = "Modelo Unicórnio (Unicorn Model)"
show_unicorn = input.bool(true, "Mostrar Zonas Unicórnio", group=grp_uni)
c_unicorn = input.color(color.new(#9c27b0, 40), "Cor do Unicórnio", group=grp_uni)

grp_fvg = "Fair Value Gaps (FVG)"
show_fvg = input.bool(true, "Mostrar FVG", group=grp_fvg)
fvg_extend = input.int(9, "Extensão do FVG (Candles)", minval=0, group=grp_fvg)
mitigate_fvg = input.bool(true, "Cortar FVG/Unicórnio ao Mitigar", group=grp_fvg)
c_fvg_bull = input.color(color.new(color.green, 85), "FVG Bullish", group=grp_fvg)
c_fvg_bear = input.color(color.new(color.red, 85), "FVG Bearish", group=grp_fvg)

grp_ote = "AMD + OTE (Fibonacci)"
show_ote = input.bool(true, "Mostrar Auto OTE (Última Perna)", group=grp_ote)

// Helper para converter string size em size type
get_size(sz_str) =>
    switch sz_str
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.tiny

sz_bos_choch = get_size(sz_bos_choch_input)
sz_sweep = get_size(sz_sweep_input)

// -----------------------------------------------------------------------------
// TYPES E ARRAYS PARA GERENCIAMENTO
// -----------------------------------------------------------------------------
// Como não podemos usar types complexos facilmente em versões antigas sem reescrever tudo,
// vamos usar arrays de boxes diretos e um array paralelo para saber se é Bull ou Bear se necessário.
// Na verdade, para mitigação, só precisamos saber as coordenadas Y.

var box[] fvg_boxes = array.new_box()
var bool[] fvg_is_bull = array.new_bool() // true=bull, false=bear

// -----------------------------------------------------------------------------
// LÓGICA DE PIVOTS E ESTRUTURA
// -----------------------------------------------------------------------------
ph = ta.pivothigh(len, len)
pl = ta.pivotlow(len, len)

// Variáveis para rastrear estrutura
var float last_high = na
var float last_low = na
var int last_high_idx = na
var int last_low_idx = na
var int dir = 0 // 1 = Bull, -1 = Bear

// Arrays para Breaker Blocks (simples: armazenar últimas zonas de estrutura rompida)
var box[] breakers = array.new_box()

// Detectar Pivots
if not na(ph)
    last_high := ph
    last_high_idx := bar_index[len]
if not na(pl)
    last_low := pl
    last_low_idx := bar_index[len]

// Detectar quebras (Ao vivo ou fechamento)
break_high = ta.crossover(close, last_high)
break_low = ta.crossunder(close, last_low)

// SWEEP: Preço violou o nível mas fechou dentro (Wick capture)
is_sweep_high = high > last_high and close < last_high and not na(last_high)
is_sweep_low = low < last_low and close > last_low and not na(last_low)

if show_sweep and is_sweep_high and high == ta.highest(high, 5)
    label.new(bar_index, high, "SWEEP", color=color.red, style=label.style_triangledown, textcolor=color.white, size=sz_sweep)
    alert("Liquidez Capturada (Topo) em " + syminfo.ticker, alert.freq_once_per_bar_close)

if show_sweep and is_sweep_low and low == ta.lowest(low, 5)
    label.new(bar_index, low, "SWEEP", color=color.green, style=label.style_triangleup, textcolor=color.white, size=sz_sweep)
    alert("Liquidez Capturada (Fundo) em " + syminfo.ticker, alert.freq_once_per_bar_close)

// BOS e CHoCH logic
if break_high and not na(last_high)
    if dir == 1
        // BOS Bull
        if show_bos
            line.new(last_high_idx, last_high, bar_index, last_high, color=color.green)
            // Texto alinhado à esquerda da linha (final)
            label.new(bar_index + 3, last_high, "BOS", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.green, size=sz_bos_choch)
    else
        // CHoCH Bull (Inversão)
        if show_choch
            line.new(last_high_idx, last_high, bar_index, last_high, color=color.green, style=line.style_dashed)
            label.new(bar_index + 3, last_high, "CHoCH", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.green, size=sz_bos_choch)

        box b = box.new(last_high_idx - 1, last_high * 1.001, bar_index + 10, last_high * 0.999, border_color=color.green, bgcolor=color.new(color.green, 90))
        array.push(breakers, b)
        dir := 1

if break_low and not na(last_low)
    if dir == -1
        // BOS Bear
        if show_bos
            line.new(last_low_idx, last_low, bar_index, last_low, color=color.red)
            label.new(bar_index + 3, last_low, "BOS", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.red, size=sz_bos_choch)
    else
        // CHoCH Bear
        if show_choch
            line.new(last_low_idx, last_low, bar_index, last_low, color=color.red, style=line.style_dashed)
            label.new(bar_index + 3, last_low, "CHoCH", color=color.new(color.white, 100), style=label.style_label_left, textcolor=color.red, size=sz_bos_choch)

        box b = box.new(last_low_idx - 1, last_low * 1.001, bar_index + 10, last_low * 0.999, border_color=color.red, bgcolor=color.new(color.red, 90))
        array.push(breakers, b)
        dir := -1

// -----------------------------------------------------------------------------
// FAIR VALUE GAPS (FVG)
// -----------------------------------------------------------------------------
fvg_bull = low > high[2]
fvg_bear = high < low[2]

// Função para criar FVG e adicionar à lista de monitoramento
create_fvg(left, top, right, bottom, col, is_bull, text_lbl) =>
    // Se "Cortar ao Mitigar" estiver ligado, right é indefinido visualmente inicialmente (extend),
    // mas vamos controlar logicamente. Se não, usamos o extend fixo no visual.
    // Usamos 'right' fixo inicial base + extend.
    b = box.new(left, top, right, bottom, border_color=na, bgcolor=col, text=text_lbl, text_color=color.white)

    if mitigate_fvg
        array.push(fvg_boxes, b)
        array.push(fvg_is_bull, is_bull)

if fvg_bull
    // FVG Normal
    if show_fvg
        bool is_uni = false
        // Checar Unicórnio Bullish
        if show_unicorn and array.size(breakers) > 0
            for i = 0 to array.size(breakers) - 1
                box b = array.get(breakers, i)
                float b_top = box.get_top(b)
                float b_btm = box.get_bottom(b)
                if (b_top >= high[2] and b_btm <= low)
                    is_uni := true

        if is_uni
            create_fvg(bar_index[2], low, bar_index + fvg_extend, high[2], c_unicorn, true, "UNICÓRNIO")
            alert("Setup Unicórnio (Bull) Detectado!", alert.freq_once_per_bar_close)
        else
            create_fvg(bar_index[2], high[2], bar_index + fvg_extend, low, c_fvg_bull, true, "")

if fvg_bear
    // FVG Normal
    if show_fvg
        bool is_uni = false
        // Checar Unicórnio Bearish
        if show_unicorn and array.size(breakers) > 0
            for i = 0 to array.size(breakers) - 1
                box b = array.get(breakers, i)
                float b_top = box.get_top(b)
                float b_btm = box.get_bottom(b)
                if (b_btm <= low[2] and b_top >= high)
                    is_uni := true

        if is_uni
            create_fvg(bar_index[2], high, bar_index + fvg_extend, low[2], c_unicorn, false, "UNICÓRNIO")
            alert("Setup Unicórnio (Bear) Detectado!", alert.freq_once_per_bar_close)
        else
            create_fvg(bar_index[2], low[2], bar_index + fvg_extend, high, c_fvg_bear, false, "")

// -----------------------------------------------------------------------------
// LÓGICA DE MITIGAÇÃO (CORTAR FVG)
// -----------------------------------------------------------------------------
if mitigate_fvg and array.size(fvg_boxes) > 0
    // Itera reverso para poder deletar se necessário (embora box.delete não seja o objetivo, queremos encurtar)
    // Na verdade, só precisamos parar de rastrear se mitigou.
    // Iterando do último para o primeiro? Não, precisamos checar todos ativos.

    // Arrays para manter só os não mitigados
    int[] indices_to_remove = array.new_int()

    for i = 0 to array.size(fvg_boxes) - 1
        box b = array.get(fvg_boxes, i)
        bool is_b = array.get(fvg_is_bull, i)

        float top = box.get_top(b)
        float bot = box.get_bottom(b)
        int right_idx = box.get_right(b)

        // Se a box já passou (velho) ou se preço atual tocou
        bool mitigated = false

        if is_b // Bullish FVG (Suporte) -> Mitiga se preço descer e tocar no Topo (ou entrar dentro)
            if low <= top
                mitigated := true
        else // Bearish FVG (Resistência) -> Mitiga se preço subir e tocar no Fundo (ou entrar dentro)
            if high >= bot
                mitigated := true

        // Se mitigou, atualizamos o 'right' para o bar_index atual e marcamos para remoção da lista de ativos
        if mitigated
            box.set_right(b, bar_index)
            array.push(indices_to_remove, i)

    // Remover da lista de rastreamento (reverso para não zoar indices)
    if array.size(indices_to_remove) > 0
        // Ordenar decrescente para remover do fim pro começo
        // Pine Script não tem sort reverso fácil para int[], mas podemos fazer loop reverso manualmente
        // Workaround: Criar novo array com os que SOBRAM é mais fácil? Não, push remove é O(N).
        // Vamos remover um por um de trás pra frente
        for j = array.size(indices_to_remove) - 1 to 0
            int idx = array.get(indices_to_remove, j)
            array.remove(fvg_boxes, idx)
            array.remove(fvg_is_bull, idx)

// Limpeza de arrays antigos
if array.size(breakers) > 10
    box.delete(array.shift(breakers))
if array.size(fvg_boxes) > 50 // Limite de segurança para FVGs ativos
    array.shift(fvg_boxes)
    array.shift(fvg_is_bull)

// -----------------------------------------------------------------------------
// OTE (OPTIMAL TRADE ENTRY) - AUTO FIB
// -----------------------------------------------------------------------------
if show_ote
    var line fib_0 = na
    var line fib_1 = na
    var line fib_618 = na
    var line fib_79 = na

    line.delete(fib_0)
    line.delete(fib_1)
    line.delete(fib_618)
    line.delete(fib_79)

    if not na(last_high) and not na(last_low)
        float top = last_high
        float btm = last_low
        int top_idx = last_high_idx
        int btm_idx = last_low_idx
        float diff = top - btm
        float lvl_618 = na
        float lvl_79 = na

        if dir == 1
            lvl_618 = top - (diff * 0.618)
            lvl_79 = top - (diff * 0.79)
        else
            lvl_618 = btm + (diff * 0.618)
            lvl_79 = btm + (diff * 0.79)

        if bar_index - top_idx < 300 and bar_index - btm_idx < 300
            fib_0 = line.new(btm_idx, btm, bar_index + 5, btm, color=color.gray, style=line.style_dotted)
            fib_1 = line.new(top_idx, top, bar_index + 5, top, color=color.gray, style=line.style_dotted)
            fib_618 = line.new(bar_index[10], lvl_618, bar_index + 5, lvl_618, color=color.yellow, width=1)
            fib_79 = line.new(bar_index[10], lvl_79, bar_index + 5, lvl_79, color=color.yellow, width=1)
            label.new(bar_index + 5, (lvl_618 + lvl_79)/2, "OTE ZONE\n(61.8% - 79%)", style=label.style_none, textcolor=color.yellow, size=size.small)
