//@version=5
indicator("Capiba SMC: Unicorn & AMD [Desbloqueando Smart Money]", shorttitle="Capiba SMC", overlay=true, max_bars_back=500, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
// CONFIGURAÇÕES E INPUTS
// -----------------------------------------------------------------------------
grp_struc = "Estrutura de Mercado"
len_int = input.int(5, "Estrutura Interna (Pivots)", group=grp_struc)
len_swing = input.int(20, "Estrutura Swing (Pivots)", group=grp_struc)
show_int = input.bool(true, "Mostrar Interna (Dashed)", group=grp_struc)
show_swing = input.bool(true, "Mostrar Swing (Solid)", group=grp_struc)
sz_bos_choch_input = input.string("Tiny", "Tamanho do Texto (BOS/CHoCH)", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_struc)

grp_liq = "Liquidez (Sweeps & EQH/L)"
show_sweep = input.bool(true, "Mostrar SWEEPS", group=grp_liq)
show_eq = input.bool(true, "Mostrar EQH/EQL (Topos/Fundos Duplos)", group=grp_liq)
sz_sweep_input = input.string("Tiny", "Tamanho do Texto (Liquidez)", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_liq)

grp_uni = "Modelo Unicórnio (Unicorn Model)"
show_unicorn = input.bool(true, "Mostrar Zonas Unicórnio", group=grp_uni)
uni_extend = input.int(9, "Extensão do Unicórnio (Candles)", minval=0, group=grp_uni)
c_unicorn = input.color(color.new(#9c27b0, 40), "Cor do Unicórnio", group=grp_uni)

grp_fvg = "Fair Value Gaps (FVG)"
show_fvg = input.bool(true, "Mostrar FVG", group=grp_fvg)
fvg_extend = input.int(9, "Extensão do FVG (Candles)", minval=0, group=grp_fvg)
mitigate_fvg = input.bool(true, "Cortar FVG/Unicórnio ao Mitigar", group=grp_fvg)
c_fvg_bull = input.color(color.new(color.green, 85), "FVG Bullish", group=grp_fvg)
c_fvg_bear = input.color(color.new(color.red, 85), "FVG Bearish", group=grp_fvg)

grp_ote = "AMD + OTE (Fibonacci)"
show_ote = input.bool(true, "Mostrar Auto OTE (Última Perna)", group=grp_ote)
show_pd = input.bool(true, "Mostrar Zonas Premium/Discount", group=grp_ote)

grp_mtf = "Níveis MTF (Highs/Lows)"
show_daily = input.bool(false, "Mostrar Daily High/Low", group=grp_mtf)
show_weekly = input.bool(false, "Mostrar Weekly High/Low", group=grp_mtf)

// Helper Sizes
get_size(sz_str) =>
    switch sz_str
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        "Huge" => size.huge
        => size.tiny

sz_bos_choch = get_size(sz_bos_choch_input)
sz_sweep = get_size(sz_sweep_input)

// -----------------------------------------------------------------------------
// ARRAYS GLOBAIS
// -----------------------------------------------------------------------------
var box[] fvg_boxes = array.new_box()
var bool[] fvg_is_bull = array.new_bool()
var box[] breakers = array.new_box()

// -----------------------------------------------------------------------------
// LÓGICA DE ESTRUTURA (SEPARADA PARA EVITAR SCOPE BUG)
// -----------------------------------------------------------------------------

// --- ESTRUTURA INTERNA ---
ph_int = ta.pivothigh(len_int, len_int)
pl_int = ta.pivotlow(len_int, len_int)

var float int_lh = na
var float int_ll = na
var int int_lh_idx = na
var int int_ll_idx = na
var int int_dir = 0
var float last_ph_int = na
var float last_pl_int = na

if not na(ph_int)
    if show_eq and not na(last_ph_int)
        dist = math.abs(ph_int - last_ph_int)
        atr = ta.atr(14)
        if dist < (atr * 0.1)
            line.new(bar_index[len_int], ph_int, bar_index, ph_int, color=color.gray, style=line.style_dotted) // Visual simplified
            label.new(bar_index[len_int], ph_int, "EQH", color=color.gray, style=label.style_label_down, textcolor=color.gray, size=sz_sweep)
    last_ph_int := ph_int
    int_lh := ph_int
    int_lh_idx := bar_index[len_int]

if not na(pl_int)
    if show_eq and not na(last_pl_int)
        dist = math.abs(pl_int - last_pl_int)
        atr = ta.atr(14)
        if dist < (atr * 0.1)
            line.new(bar_index[len_int], pl_int, bar_index, pl_int, color=color.gray, style=line.style_dotted)
            label.new(bar_index[len_int], pl_int, "EQL", color=color.gray, style=label.style_label_up, textcolor=color.gray, size=sz_sweep)
    last_pl_int := pl_int
    int_ll := pl_int
    int_ll_idx := bar_index[len_int]

int_bk_h = ta.crossover(close, int_lh)
int_bk_l = ta.crossunder(close, int_ll)

// Sweeps Internos
s_h_int = high > int_lh and close < int_lh and not na(int_lh)
s_l_int = low < int_ll and close > int_ll and not na(int_ll)

if show_sweep and s_h_int and high == ta.highest(high, 5)
    label.new(bar_index, high, "SWEEP", color=color.red, style=label.style_triangledown, textcolor=color.white, size=sz_sweep)
if show_sweep and s_l_int and low == ta.lowest(low, 5)
    label.new(bar_index, low, "SWEEP", color=color.green, style=label.style_triangleup, textcolor=color.white, size=sz_sweep)

if int_bk_h and not na(int_lh)
    if int_dir == 1
        // BOS Bull
        if show_int
            line.new(int_lh_idx, int_lh, bar_index, int_lh, color=color.green, style=line.style_dashed)
            label.new(bar_index + 3, int_lh, "BOS", color=color.new(color.white, 100), style=label.style_label_lower_right, textcolor=color.green, size=sz_bos_choch)
    else
        // CHoCH Bull
        if show_int
            line.new(int_lh_idx, int_lh, bar_index, int_lh, color=color.green, style=line.style_dashed)
            label.new(bar_index + 3, int_lh, "CHoCH", color=color.new(color.white, 100), style=label.style_label_lower_right, textcolor=color.green, size=sz_bos_choch)

        // Breaker Interno (Para Unicórnio)
        box b = box.new(int_lh_idx - 1, int_lh * 1.001, bar_index + 10, int_lh * 0.999, border_color=color.green, bgcolor=color.new(color.green, 90))
        array.push(breakers, b)

        int_dir := 1

if int_bk_l and not na(int_ll)
    if int_dir == -1
        // BOS Bear
        if show_int
            line.new(int_ll_idx, int_ll, bar_index, int_ll, color=color.red, style=line.style_dashed)
            label.new(bar_index + 3, int_ll, "BOS", color=color.new(color.white, 100), style=label.style_label_upper_right, textcolor=color.red, size=sz_bos_choch)
    else
        // CHoCH Bear
        if show_int
            line.new(int_ll_idx, int_ll, bar_index, int_ll, color=color.red, style=line.style_dashed)
            label.new(bar_index + 3, int_ll, "CHoCH", color=color.new(color.white, 100), style=label.style_label_upper_right, textcolor=color.red, size=sz_bos_choch)

        box b = box.new(int_ll_idx - 1, int_ll * 1.001, bar_index + 10, int_ll * 0.999, border_color=color.red, bgcolor=color.new(color.red, 90))
        array.push(breakers, b)

        int_dir := -1

// --- ESTRUTURA SWING ---
ph_sw = ta.pivothigh(len_swing, len_swing)
pl_sw = ta.pivotlow(len_swing, len_swing)

var float sw_lh = na
var float sw_ll = na
var int sw_lh_idx = na
var int sw_ll_idx = na
var int sw_dir = 0
var float last_ph_sw = na
var float last_pl_sw = na

if not na(ph_sw)
    if show_eq and not na(last_ph_sw)
        dist = math.abs(ph_sw - last_ph_sw)
        atr = ta.atr(14)
        if dist < (atr * 0.1)
            line.new(bar_index[len_swing], ph_sw, bar_index, ph_sw, color=color.gray, style=line.style_dotted)
            label.new(bar_index[len_swing], ph_sw, "EQH", color=color.gray, style=label.style_label_down, textcolor=color.gray, size=sz_sweep)
    last_ph_sw := ph_sw
    sw_lh := ph_sw
    sw_lh_idx := bar_index[len_swing]

if not na(pl_sw)
    if show_eq and not na(last_pl_sw)
        dist = math.abs(pl_sw - last_pl_sw)
        atr = ta.atr(14)
        if dist < (atr * 0.1)
            line.new(bar_index[len_swing], pl_sw, bar_index, pl_sw, color=color.gray, style=line.style_dotted)
            label.new(bar_index[len_swing], pl_sw, "EQL", color=color.gray, style=label.style_label_up, textcolor=color.gray, size=sz_sweep)
    last_pl_sw := pl_sw
    sw_ll := pl_sw
    sw_ll_idx := bar_index[len_swing]

sw_bk_h = ta.crossover(close, sw_lh)
sw_bk_l = ta.crossunder(close, sw_ll)

if sw_bk_h and not na(sw_lh)
    if sw_dir == 1
        if show_swing
            line.new(sw_lh_idx, sw_lh, bar_index, sw_lh, color=color.green, style=line.style_solid, width=2)
            label.new(bar_index + 3, sw_lh, "Major BOS", color=color.new(color.white, 100), style=label.style_label_lower_right, textcolor=color.green, size=sz_bos_choch)
    else
        if show_swing
            line.new(sw_lh_idx, sw_lh, bar_index, sw_lh, color=color.green, style=line.style_solid, width=2)
            label.new(bar_index + 3, sw_lh, "Major CHoCH", color=color.new(color.white, 100), style=label.style_label_lower_right, textcolor=color.green, size=sz_bos_choch)
        sw_dir := 1

if sw_bk_l and not na(sw_ll)
    if sw_dir == -1
        if show_swing
            line.new(sw_ll_idx, sw_ll, bar_index, sw_ll, color=color.red, style=line.style_solid, width=2)
            label.new(bar_index + 3, sw_ll, "Major BOS", color=color.new(color.white, 100), style=label.style_label_upper_right, textcolor=color.red, size=sz_bos_choch)
    else
        if show_swing
            line.new(sw_ll_idx, sw_ll, bar_index, sw_ll, color=color.red, style=line.style_solid, width=2)
            label.new(bar_index + 3, sw_ll, "Major CHoCH", color=color.new(color.white, 100), style=label.style_label_upper_right, textcolor=color.red, size=sz_bos_choch)
        sw_dir := -1

// -----------------------------------------------------------------------------
// FAIR VALUE GAPS (FVG) & UNICORN
// -----------------------------------------------------------------------------
fvg_bull = low > high[2]
fvg_bear = high < low[2]

create_fvg(left, top, right, bottom, col, is_bull, text_lbl) =>
    b = box.new(left, top, right, bottom, border_color=na, bgcolor=col, text=text_lbl, text_color=color.white)
    if mitigate_fvg
        array.push(fvg_boxes, b)
        array.push(fvg_is_bull, is_bull)

if fvg_bull
    if show_fvg
        bool is_uni = false
        // Check Unicorn (Breaker Intersect)
        if show_unicorn and array.size(breakers) > 0
            for i = 0 to array.size(breakers) - 1
                box b = array.get(breakers, i)
                float b_top = box.get_top(b)
                float b_btm = box.get_bottom(b)
                if (b_top >= high[2] and b_btm <= low)
                    is_uni := true

        if is_uni
            create_fvg(bar_index[2], low, bar_index + uni_extend, high[2], c_unicorn, true, "UNICÓRNIO")
            alert("Unicórnio Bullish!", alert.freq_once_per_bar_close)
        else
            create_fvg(bar_index[2], high[2], bar_index + fvg_extend, low, c_fvg_bull, true, "")

if fvg_bear
    if show_fvg
        bool is_uni = false
        if show_unicorn and array.size(breakers) > 0
            for i = 0 to array.size(breakers) - 1
                box b = array.get(breakers, i)
                float b_top = box.get_top(b)
                float b_btm = box.get_bottom(b)
                if (b_btm <= low[2] and b_top >= high)
                    is_uni := true

        if is_uni
            create_fvg(bar_index[2], high, bar_index + uni_extend, low[2], c_unicorn, false, "UNICÓRNIO")
            alert("Unicórnio Bearish!", alert.freq_once_per_bar_close)
        else
            create_fvg(bar_index[2], low[2], bar_index + fvg_extend, high, c_fvg_bear, false, "")

// Mitigação
if mitigate_fvg and array.size(fvg_boxes) > 0
    int[] indices_to_remove = array.new_int()
    for i = 0 to array.size(fvg_boxes) - 1
        box b = array.get(fvg_boxes, i)
        bool is_b = array.get(fvg_is_bull, i)
        float top = box.get_top(b)
        float bot = box.get_bottom(b)
        bool mit = false

        if is_b
            if low <= top
                mit := true
        else
            if high >= bot
                mit := true
        if mit
            box.set_right(b, bar_index)
            array.push(indices_to_remove, i)

    if array.size(indices_to_remove) > 0
        for j = array.size(indices_to_remove) - 1 to 0
            int idx = array.get(indices_to_remove, j)
            array.remove(fvg_boxes, idx)
            array.remove(fvg_is_bull, idx)

// Garbage Collection
if array.size(breakers) > 10
    box.delete(array.shift(breakers))
if array.size(fvg_boxes) > 50
    array.shift(fvg_boxes)
    array.shift(fvg_is_bull)

// -----------------------------------------------------------------------------
// OTE & ZONES
// -----------------------------------------------------------------------------
if show_ote
    var line fib_0 = na
    var line fib_1 = na
    var line fib_618 = na
    var line fib_79 = na
    var label ote_lbl = na
    var box pd_box_prem = na
    var box pd_box_disc = na

    line.delete(fib_0)
    line.delete(fib_1)
    line.delete(fib_618)
    line.delete(fib_79)
    label.delete(ote_lbl)
    box.delete(pd_box_prem)
    box.delete(pd_box_disc)

    // Usamos estrutura Interna para OTE (mais rápido/recente)
    if not na(int_lh) and not na(int_ll)
        float top = int_lh
        float btm = int_ll
        int top_idx = int_lh_idx
        int btm_idx = int_ll_idx
        float diff = top - btm

        // Se dif for muito pequena ou antiga, ignora
        if bar_index - top_idx < 300 and bar_index - btm_idx < 300

            float lvl_618 = na
            float lvl_79 = na
            float lvl_50 = (top + btm) / 2

            // OTE Lines
            if int_dir == 1 // Bullish -> Retração para baixo
                lvl_618 := top - (diff * 0.618)
                lvl_79 := top - (diff * 0.79)

                // Premium (0-50% retracement = Topo até 50%) -> Bad Buy
                // Discount (50-100% retracement = 50% até Fundo) -> Good Buy
                if show_pd
                    pd_box_prem := box.new(btm_idx, top, bar_index + 10, lvl_50, bgcolor=color.new(color.red, 95), border_color=na)
                    pd_box_disc := box.new(btm_idx, lvl_50, bar_index + 10, btm, bgcolor=color.new(color.green, 95), border_color=na)

            else // Bearish -> Retração para cima
                lvl_618 := btm + (diff * 0.618)
                lvl_79 := btm + (diff * 0.79)

                // Premium (High Prices) -> Good Sell
                // Discount (Low Prices) -> Bad Sell
                if show_pd
                    pd_box_prem := box.new(top_idx, top, bar_index + 10, lvl_50, bgcolor=color.new(color.red, 95), border_color=na)
                    pd_box_disc := box.new(top_idx, lvl_50, bar_index + 10, btm, bgcolor=color.new(color.green, 95), border_color=na)

            // Lines
            fib_0 = line.new(btm_idx, btm, bar_index + 5, btm, color=color.gray, style=line.style_dotted)
            fib_1 = line.new(top_idx, top, bar_index + 5, top, color=color.gray, style=line.style_dotted)
            fib_618 = line.new(bar_index[10], lvl_618, bar_index + 5, lvl_618, color=color.yellow, width=1)
            fib_79 = line.new(bar_index[10], lvl_79, bar_index + 5, lvl_79, color=color.yellow, width=1)
            ote_lbl := label.new(bar_index + 5, (lvl_618 + lvl_79)/2, "OTE", style=label.style_none, textcolor=color.yellow, size=size.small)

// -----------------------------------------------------------------------------
// MTF LEVELS
// -----------------------------------------------------------------------------
draw_mtf(tf, col, txt) =>
    // Corrigindo Repainting: Usando lookahead_off para dados em tempo real ou Previous Day High/Low
    // A convenção SMC sólida é usar Previous [TF] High/Low
    [ph, pl] = request.security(syminfo.tickerid, tf, [high[1], low[1]], lookahead=barmerge.lookahead_on)
    // Nota: high[1] com lookahead_on PODE repintar se o bar não estiver fechado? Não, index [1] é fechado.
    // Mas usar lookahead_on em dados históricos é arriscado. O ideal é usar lookahead_off para evitar qualquer viés.
    // Mas Previous Day High/Low é estático durante o dia.
    // Vamos usar a forma mais segura: Sem lookahead, pegando high/low anteriores.

    var line lh = na
    var line ll = na
    var label lbh = na
    var label lbl = na

    line.delete(lh)
    line.delete(ll)
    label.delete(lbh)
    label.delete(lbl)

    // Desenha linhas projetadas
    if barstate.islast
        lh := line.new(bar_index - 10, ph, bar_index + 10, ph, color=col)
        ll := line.new(bar_index - 10, pl, bar_index + 10, pl, color=col)
        lbh := label.new(bar_index + 10, ph, "Prev " + txt + " H", style=label.style_label_left, textcolor=col, size=size.tiny)
        lbl := label.new(bar_index + 10, pl, "Prev " + txt + " L", style=label.style_label_left, textcolor=col, size=size.tiny)

if show_daily
    draw_mtf("D", color.blue, "D")
if show_weekly
    draw_mtf("W", color.orange, "W")
