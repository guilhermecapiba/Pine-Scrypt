//@version=6
indicator("Capiba Liquidity Levels", overlay=true, max_lines_count=500, max_labels_count=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
lookback     = input.int(20,    "Pivot Lookback",       minval=5)
eqThreshold  = input.float(0.1, "Equal H/L Threshold %", minval=0.01, step=0.01)
showSwept    = input.bool(true, "Show Swept Levels")
maxLevels    = input.int(20,    "Max Active Levels",    minval=1, maxval=100)
colorBuy     = input.color(color.new(#00bcd4, 0),  "Buyside Color")
colorSell    = input.color(color.new(#ff5722, 0),  "Sellside Color")
colorSwept   = input.color(color.new(#888888, 60), "Swept Color")

// ─── TYPES ────────────────────────────────────────────────────────────────────
type LiqLevel
    float  price
    int    barStart
    bool   isHigh     // true = buyside, false = sellside
    bool   swept
    bool   isEq       // true = Equal High/Low
    line   ln
    label  lbl

// ─── STATE ────────────────────────────────────────────────────────────────────
var LiqLevel[] levels = array.new<LiqLevel>()

// ─── PIVOT DETECTION ──────────────────────────────────────────────────────────
pivHigh = ta.pivothigh(high, lookback, lookback)
pivLow  = ta.pivotlow(low,  lookback, lookback)

// ─── CHECK IF EQUAL (liquidity pool) ─────────────────────────────────────────
isEqual(float a, float b, float threshold) =>
    math.abs(a - b) / b * 100 <= threshold

// ─── PROCESS PIVOTS ───────────────────────────────────────────────────────────
if not na(pivHigh)
    float phPrice = pivHigh
    int   phBar   = bar_index - lookback
    bool  merged  = false

    if levels.size() > 0
        for i = 0 to levels.size() - 1
            lv = levels.get(i)
            if lv.isHigh
                if isEqual(lv.price, phPrice, eqThreshold)
                    lv.isEq := true
                    lv.price := math.max(lv.price, phPrice)
                    line.set_y1(lv.ln, lv.price)
                    line.set_y2(lv.ln, lv.price)
                    label.set_y(lv.lbl, lv.price)
                    label.set_text(lv.lbl, "EQH")
                    line.set_width(lv.ln, 2)
                    merged := true
                    break

    if not merged
        bool alreadySwept = false
        int  sweepBar = bar_index
        // Check from the candle immediately after the pivot up to the current candle
        for j = lookback - 1 to 0
            if high[j] > phPrice
                alreadySwept := true
                sweepBar := bar_index - j
                break

        if alreadySwept
            if showSwept
                line.new(phBar, phPrice, sweepBar, phPrice, color=colorSwept, width=1, style=line.style_dotted)
                label.new(sweepBar, phPrice, "⚡BSL", color=color.new(colorSwept, 85), textcolor=colorSwept, style=label.style_label_left, size=size.small)
        else
            ln = line.new(phBar, phPrice, bar_index + 10, phPrice, color=colorBuy, width=1, style=line.style_dashed)
            lbl = label.new(bar_index + 10, phPrice, "BSL", color=color.new(colorBuy, 85), textcolor=colorBuy, style=label.style_label_left, size=size.small)
            levels.push(LiqLevel.new(phPrice, phBar, true, false, false, ln, lbl))

if not na(pivLow)
    float plPrice = pivLow
    int   plBar   = bar_index - lookback
    bool  merged  = false

    if levels.size() > 0
        for i = 0 to levels.size() - 1
            lv = levels.get(i)
            if not lv.isHigh
                if isEqual(lv.price, plPrice, eqThreshold)
                    lv.isEq := true
                    lv.price := math.min(lv.price, plPrice)
                    line.set_y1(lv.ln, lv.price)
                    line.set_y2(lv.ln, lv.price)
                    label.set_y(lv.lbl, lv.price)
                    label.set_text(lv.lbl, "EQL")
                    line.set_width(lv.ln, 2)
                    merged := true
                    break

    if not merged
        bool alreadySwept = false
        int  sweepBar = bar_index
        for j = lookback - 1 to 0
            if low[j] < plPrice
                alreadySwept := true
                sweepBar := bar_index - j
                break

        if alreadySwept
            if showSwept
                line.new(plBar, plPrice, sweepBar, plPrice, color=colorSwept, width=1, style=line.style_dotted)
                label.new(sweepBar, plPrice, "⚡SSL", color=color.new(colorSwept, 85), textcolor=colorSwept, style=label.style_label_left, size=size.small)
        else
            ln = line.new(plBar, plPrice, bar_index + 10, plPrice, color=colorSell, width=1, style=line.style_dashed)
            lbl = label.new(bar_index + 10, plPrice, "SSL", color=color.new(colorSell, 85), textcolor=colorSell, style=label.style_label_left, size=size.small)
            levels.push(LiqLevel.new(plPrice, plBar, false, false, false, ln, lbl))

// ─── SWEEP CHECK & EXTEND ─────────────────────────────────────────────────────
if levels.size() > 0
    for i = levels.size() - 1 to 0
        lv = levels.get(i)

        bool isSweptNow = false
        if lv.isHigh and high > lv.price
            isSweptNow := true
        else if not lv.isHigh and low < lv.price
            isSweptNow := true

        if isSweptNow
            if showSwept
                line.set_color(lv.ln, colorSwept)
                line.set_style(lv.ln, line.style_dotted)
                line.set_x2(lv.ln, bar_index)
                label.set_color(lv.lbl, color.new(colorSwept, 85))
                label.set_textcolor(lv.lbl, colorSwept)

                string txt = ""
                if lv.isHigh
                    txt := lv.isEq ? "⚡EQH" : "⚡BSL"
                else
                    txt := lv.isEq ? "⚡EQL" : "⚡SSL"
                label.set_text(lv.lbl, txt)
                label.set_x(lv.lbl, bar_index)
            else
                line.delete(lv.ln)
                label.delete(lv.lbl)
            // Once swept, we don't need to track it anymore
            levels.remove(i)
        else if barstate.islast
            // To prevent massive chart lag on thousands of historical bars,
            // we only continuously extend the visual objects dynamically on the LIVE bar.
            line.set_x2(lv.ln, bar_index + 10)
            label.set_x(lv.lbl, bar_index + 10)

// Also execute one big historical extension on the very last calculated bar for active lines
// so they visually stretch up to the current timeframe.
if barstate.islastconfirmedhistory
    if levels.size() > 0
        for i = 0 to levels.size() - 1
            lv = levels.get(i)
            line.set_x2(lv.ln, bar_index + 10)
            label.set_x(lv.lbl, bar_index + 10)

// ─── GARBAGE COLLECTION ───────────────────────────────────────────────────────
if levels.size() > maxLevels
    int toRemove = levels.size() - maxLevels
    for i = 0 to toRemove - 1
        lv = levels.shift()
        line.delete(lv.ln)
        label.delete(lv.lbl)
