//@version=6
indicator("risk adoption mapper", overlay=false)

// Configuração do período da EMA
ema_rsi_len = input.int(20, title="Períodos da EMA da Risk Line")

// Função para obter dados de cada ativo
get_data() =>
    c = close
    e20 = ta.ema(c, 20)
    e200 = ta.ema(c, 200)
    [c, e20, e200]

// Símbolos diretos
sym_hyg     = "AMEX:HYG"
sym_spx     = "SPX"
sym_ndx     = "NDX"
sym_us2000  = "US2000"
sym_silvau  = "TVC:SILVER/TVC:GOLD"
sym_usdjpy  = "USDJPY"
sym_liq     = "FRED:WALCL-FRED:WTREGEN-FRED:RRPONTSYD"

// Símbolos invertidos
sym_move    = "MOVE"
sym_us10y   = "US10Y"
sym_dxy     = "DXY"

// Obtendo dados de cada ativo direto
[c_hyg, e20_hyg, e200_hyg]          = request.security(sym_hyg, timeframe.period, get_data())
[c_spx, e20_spx, e200_spx]          = request.security(sym_spx, timeframe.period, get_data())
[c_ndx, e20_ndx, e200_ndx]          = request.security(sym_ndx, timeframe.period, get_data())
[c_us2000, e20_us2000, e200_us2000] = request.security(sym_us2000, timeframe.period, get_data())
[c_silvau, e20_silvau, e200_silvau] = request.security(sym_silvau, timeframe.period, get_data())
[c_usdjpy, e20_usdjpy, e200_usdjpy] = request.security(sym_usdjpy, timeframe.period, get_data())
[c_liq, e20_liq, e200_liq]          = request.security(sym_liq, timeframe.period, get_data())

// Obtendo dados de cada ativo invertido
[c_move, e20_move, e200_move]       = request.security(sym_move, timeframe.period, get_data())
[c_us10y, e20_us10y, e200_us10y]    = request.security(sym_us10y, timeframe.period, get_data())
[c_dxy, e20_dxy, e200_dxy]          = request.security(sym_dxy, timeframe.period, get_data())

// Função de pontuação direta (+0.5 acima EMA 20, +0.5 acima EMA 200)
calc_score(c, e20, e200) =>
    score = 0.0
    if not na(c) and not na(e20) and not na(e200)
        if c > e20
            score += 0.5
        if c > e200
            score += 0.5
    score

// Função de pontuação invertida (+0.5 abaixo EMA 20, +0.5 abaixo EMA 200)
calc_inv_score(c, e20, e200) =>
    score = 0.0
    if not na(c) and not na(e20) and not na(e200)
        if c < e20
            score += 0.5
        if c < e200
            score += 0.5
    score

// Calculando pontuação de cada ativo
score_hyg    = calc_score(c_hyg, e20_hyg, e200_hyg)
score_spx    = calc_score(c_spx, e20_spx, e200_spx)
score_ndx    = calc_score(c_ndx, e20_ndx, e200_ndx)
score_us2000 = calc_score(c_us2000, e20_us2000, e200_us2000)
score_silvau = calc_score(c_silvau, e20_silvau, e200_silvau)
score_usdjpy = calc_score(c_usdjpy, e20_usdjpy, e200_usdjpy)
score_liq    = calc_score(c_liq, e20_liq, e200_liq)

score_move   = calc_inv_score(c_move, e20_move, e200_move)
score_us10y  = calc_inv_score(c_us10y, e20_us10y, e200_us10y)
score_dxy    = calc_inv_score(c_dxy, e20_dxy, e200_dxy)

// Pontuação Total (Max 10 pontos) multiplicada por 10 (Escala 0 a 100)
total_score = (score_hyg + score_spx + score_ndx + score_us2000 + score_silvau + score_usdjpy + score_liq + score_move + score_us10y + score_dxy) * 10

// Calculando a EMA da Risk Line
ema_risk = ta.ema(total_score, ema_rsi_len)

// Linhas de referência (Visual RSI)
hline(100, title="Max", color=color.gray, linestyle=hline.style_dashed)
hline(80, title="Overbought", color=color.gray, linestyle=hline.style_dotted)
hline(50, title="Midline", color=color.gray, linestyle=hline.style_solid)
hline(20, title="Oversold", color=color.gray, linestyle=hline.style_dotted)
hline(0, title="Min", color=color.gray, linestyle=hline.style_dashed)

// Plotando a Risk Line (roxa) e a EMA (amarela)
plot(total_score, title="risk line", color=color.purple, linewidth=2)
plot(ema_risk, title="EMA", color=color.yellow, linewidth=2)

// Tabela de Informações
var table info_table = table.new(position.top_right, 2, 11)

if barstate.islast
    table.cell(info_table, 0, 0, "Risk Adoption Assets")
    table.cell(info_table, 1, 0, "Tipo")

    table.cell(info_table, 0, 1, sym_hyg)
    table.cell(info_table, 1, 1, "Direto")

    table.cell(info_table, 0, 2, sym_spx)
    table.cell(info_table, 1, 2, "Direto")

    table.cell(info_table, 0, 3, sym_ndx)
    table.cell(info_table, 1, 3, "Direto")

    table.cell(info_table, 0, 4, sym_us2000)
    table.cell(info_table, 1, 4, "Direto")

    table.cell(info_table, 0, 5, sym_silvau)
    table.cell(info_table, 1, 5, "Direto")

    table.cell(info_table, 0, 6, sym_usdjpy)
    table.cell(info_table, 1, 6, "Direto")

    table.cell(info_table, 0, 7, sym_liq)
    table.cell(info_table, 1, 7, "Direto")

    table.cell(info_table, 0, 8, sym_move)
    table.cell(info_table, 1, 8, "Invertido")

    table.cell(info_table, 0, 9, sym_us10y)
    table.cell(info_table, 1, 9, "Invertido")

    table.cell(info_table, 0, 10, sym_dxy)
    table.cell(info_table, 1, 10, "Invertido")
