//@version=5
indicator("Crypto Macro Indicator", shorttitle="Crypto Macro", overlay=false)

// -----------------------------------------------------------------------------
// 1. INPUTS
// -----------------------------------------------------------------------------

// Symbols
sym_rut = input.symbol("TVC:RUT", "RUT Symbol")
sym_spx = input.symbol("TVC:SPX", "SPX Symbol")

// Calculation Settings
grp_calc = "Configuração do Fluxo"
len      = input.int(20, "Período de Análise (Média)", minval=5, group=grp_calc)
smooth   = input.int(8, "Suavização Gaussiana", minval=1, group=grp_calc)

// Visual Settings
grp_vis = "Visualização de Linhas"
col_main   = input.color(color.blue, "Cor Principal", group=grp_vis, inline="1")
wid_main   = input.int(2, "", minval=1, group=grp_vis, inline="1")

col_ema20  = input.color(color.orange, "Cor EMA 20 (Laranja)", group=grp_vis, inline="3")
wid_ema20  = input.int(2, "", minval=1, group=grp_vis, inline="3")

col_ema200 = input.color(color.white, "Cor EMA 200 (Branca)", group=grp_vis, inline="4")
wid_ema200 = input.int(1, "", minval=1, group=grp_vis, inline="4")

grp_style = "Zonas de Exaustão (OB/OS)"
obValue   = input.float(80, 'Limite Superior (OB)', inline = 'ob', group = grp_style)
obAreaCss = input(color.new(#00c853, 70), 'Cor Alta', inline = 'ob', group = grp_style)
osValue   = input.float(20, 'Limite Inferior (OS)', inline = 'os', group = grp_style)
osAreaCss = input(color.new(#ff1744, 70), 'Cor Baixa', inline = 'os', group = grp_style)

// -----------------------------------------------------------------------------
// 2. BUSCA DE DADOS E CÁLCULO
// -----------------------------------------------------------------------------

// We use the current chart's data for the asset
curr_close = close
curr_high = high
curr_low = low

// Fetch external data
rut = request.security(sym_rut, timeframe.period, close)
spx = request.security(sym_spx, timeframe.period, close)

// Formula: Asset / (RUT / SPX) - Asset
ratio_market = (rut != 0 and spx != 0) ? (rut / spx) : na
raw_value = (not na(ratio_market) and ratio_market != 0) ? (curr_close / ratio_market - curr_close) : na

// Normalization Logic (Z-Score -> Sigmoid)
mean       = ta.sma(raw_value, len)
stdDev     = ta.stdev(raw_value, len)
zScore     = stdDev != 0 ? (raw_value - mean) / stdDev : 0
normalized = 100 / (1 + math.exp(-zScore))

// Smoothing
main_value = ta.ema(normalized, smooth)

// EMAs on the normalized/smoothed value
ema20   = ta.ema(main_value, 20)
ema200  = ta.ema(main_value, 200)

// -----------------------------------------------------------------------------
// 3. PLOTAGEM
// -----------------------------------------------------------------------------
plot_up  = plot(obValue, color = na, editable = false)
plot_avg = plot(50, color = na, editable = false)
plot_dn  = plot(osValue, color = na, editable = false)

plot_main = plot(main_value, "Crypto Macro", color=col_main, linewidth=wid_main)
plot(ema20, "EMA 20", color=col_ema20, linewidth=wid_ema20)
plot(ema200, "EMA 200", color=col_ema200, linewidth=wid_ema200)

// Fills
fill(plot_main, plot_up, main_value > obValue ? obAreaCss : na, title="Excesso Alta")
fill(plot_dn, plot_main, main_value < osValue ? osAreaCss : na, title="Excesso Baixa")

fill(plot_main, plot_avg, obValue, 50, obAreaCss, color.new(chart.bg_color, 100))
fill(plot_avg, plot_main, 50, osValue, color.new(chart.bg_color, 100), osAreaCss)

// Horizontal Lines
hline(obValue, 'OB Line', color=color.new(obAreaCss, 30))
hline(50, 'Midline', color=color.new(color.gray, 50), linewidth=1)
hline(osValue, 'OS Line', color=color.new(osAreaCss, 30))

// -----------------------------------------------------------------------------
// 4. DIVERGÊNCIAS
// -----------------------------------------------------------------------------
string groupDiv = "Divergence Detection"
showDivergences = input.bool(true, "Show Divergences?", group = groupDiv)
pivotLeft = input.int(5, "Pivot Lookback Left", minval = 1, group = groupDiv)
pivotRight = input.int(5, "Pivot Lookback Right", minval = 1, group = groupDiv)
bullishDivColor = input.color(color.new(color.green, 0), "Bullish Color", inline="bull", group = groupDiv)
bullishLineWidth = input.int(2, "Line Width", minval=1, inline="bull", group=groupDiv)
bearishDivColor = input.color(color.new(color.red, 0), "Bearish Color", inline="bear", group = groupDiv)
bearishLineWidth = input.int(2, "Line Width", minval=1, inline="bear", group=groupDiv)

if showDivergences
    // We compare the Indicator (main_value) pivots vs the Price (curr_high / curr_low) pivots

    pivotHighInd = ta.pivothigh(main_value, pivotLeft, pivotRight)
    pivotLowInd = ta.pivotlow(main_value, pivotLeft, pivotRight)

    // --- BEARISH DIVERGENCE ---
    // Price makes Higher High, Indicator makes Lower High
    if not na(pivotHighInd)
        // Find previous pivot high of indicator
        prevPivotHighInd_val = ta.valuewhen(pivotHighInd, main_value[pivotRight], 1)
        // Find price at that previous pivot moment
        prevPivotHigh_price = ta.valuewhen(pivotHighInd, curr_high[pivotRight], 1)
        // Find bar index
        prevPivotHigh_bar = ta.valuewhen(pivotHighInd, bar_index[pivotRight], 1)

        // Comparison
        if not na(prevPivotHigh_price) and not na(prevPivotHighInd_val)
            if curr_high[pivotRight] > prevPivotHigh_price and main_value[pivotRight] < prevPivotHighInd_val
                line.new(prevPivotHigh_bar, prevPivotHighInd_val, bar_index[pivotRight], main_value[pivotRight], color=bearishDivColor, width=bearishLineWidth)

    // --- BULLISH DIVERGENCE ---
    // Price makes Lower Low, Indicator makes Higher Low
    if not na(pivotLowInd)
        // Find previous pivot low of indicator
        prevPivotLowInd_val = ta.valuewhen(pivotLowInd, main_value[pivotRight], 1)
        // Find price at that previous pivot moment
        prevPivotLow_price = ta.valuewhen(pivotLowInd, curr_low[pivotRight], 1)
        // Find bar index
        prevPivotLow_bar = ta.valuewhen(pivotLowInd, bar_index[pivotRight], 1)

        // Comparison
        if not na(prevPivotLow_price) and not na(prevPivotLowInd_val)
            if curr_low[pivotRight] < prevPivotLow_price and main_value[pivotRight] > prevPivotLowInd_val
                line.new(prevPivotLow_bar, prevPivotLowInd_val, bar_index[pivotRight], main_value[pivotRight], color=bullishDivColor, width=bullishLineWidth)
