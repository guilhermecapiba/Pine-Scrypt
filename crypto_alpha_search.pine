//@version=5
indicator("Crypto Alpha Search (Top 3)", shorttitle="Capiba Alpha Search", overlay=true)

// -----------------------------------------------------------------------------
// 1. CONFIGURAÇÃO
// -----------------------------------------------------------------------------
group_sets = "Configurações"
len = input.int(20, "Período da Média (SMA)", minval=5, group=group_sets)
limit_calls = "Nota: Monitorando as 10 principais Altcoins para máxima estabilidade."

// -----------------------------------------------------------------------------
// 2. FUNÇÃO DE CÁLCULO
// -----------------------------------------------------------------------------
// Calcula a força relativa da dominância atual contra sua própria média
calc_strength(ticker) =>
    // 'ignore_invalid_symbol' previne erros se o ticker não existir
    val = request.security(ticker, timeframe.period, close, ignore_invalid_symbol = true)
    // 'nz' garante que não haja erro matemático com 'na'
    valid_val = nz(val, 0)

    // Calcula a média apenas se o valor for válido
    avg = valid_val != 0 ? ta.sma(valid_val, len) : 0

    // Retorna a força ou -999 se dados insuficientes
    strength = (valid_val > 0 and avg > 0) ? (valid_val / avg) - 1 : -999
    strength

// -----------------------------------------------------------------------------
// 3. COLETA DE DADOS (TOP 10 ALTS - Ultra Safe List)
// -----------------------------------------------------------------------------
// Apenas as Top 10 Altcoins mais líquidas e com histórico garantido no TradingView
s01 = calc_strength("CRYPTOCAP:ETH.D")
s02 = calc_strength("CRYPTOCAP:BNB.D")
s03 = calc_strength("CRYPTOCAP:SOL.D")
s04 = calc_strength("CRYPTOCAP:XRP.D")
s05 = calc_strength("CRYPTOCAP:ADA.D")
s06 = calc_strength("CRYPTOCAP:DOGE.D")
s07 = calc_strength("CRYPTOCAP:AVAX.D")
s08 = calc_strength("CRYPTOCAP:TRX.D")
s09 = calc_strength("CRYPTOCAP:DOT.D")
s10 = calc_strength("CRYPTOCAP:LINK.D")

// -----------------------------------------------------------------------------
// 4. PROCESSAMENTO E ORDENAÇÃO
// -----------------------------------------------------------------------------
// Arrays de tamanho 10
var names = array.new_string(10)
var values = array.new_float(10)

// Executa a lógica pesada apenas no último candle confirmado
if barstate.islast
    array.set(names, 0, "ETH")
    array.set(values, 0, s01)
    array.set(names, 1, "BNB")
    array.set(values, 1, s02)
    array.set(names, 2, "SOL")
    array.set(values, 2, s03)
    array.set(names, 3, "XRP")
    array.set(values, 3, s04)
    array.set(names, 4, "ADA")
    array.set(values, 4, s05)
    array.set(names, 5, "DOGE")
    array.set(values, 5, s06)
    array.set(names, 6, "AVAX")
    array.set(values, 6, s07)
    array.set(names, 7, "TRX")
    array.set(values, 7, s08)
    array.set(names, 8, "DOT")
    array.set(values, 8, s09)
    array.set(names, 9, "LINK")
    array.set(values, 9, s10)

    // Bubble Sort simples (0 a 9)
    for i = 0 to 9
        for j = i + 1 to 9
            if array.get(values, i) < array.get(values, j)
                // Swap Values
                tempVal = array.get(values, i)
                array.set(values, i, array.get(values, j))
                array.set(values, j, tempVal)
                // Swap Names
                tempName = array.get(names, i)
                array.set(names, i, array.get(names, j))
                array.set(names, j, tempName)

// -----------------------------------------------------------------------------
// 5. DISPLAY (TABELA)
// -----------------------------------------------------------------------------
// Uso apenas de argumentos posicionais obrigatórios para evitar erros de sintaxe
var table panel = table.new(position.top_right, 2, 4)

if barstate.islast
    // Header
    table.cell(panel, 0, 0, "TOP ALPHA", bgcolor=color.new(color.blue, 30), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 0, "% vs SMA" + str.tostring(len), bgcolor=color.new(color.blue, 30), text_color=color.white, text_size=size.normal)

    // Helper para cor e texto
    // Se o valor for -999 (inválido), mostra "-"

    // 1º Lugar
    v1 = array.get(values, 0)
    n1 = array.get(names, 0)
    displayV1 = v1 != -999 ? str.tostring(v1 * 100, "#.##") + "%" : "-"
    color1 = v1 > 0 ? color.green : color.red

    table.cell(panel, 0, 1, n1, bgcolor=color.new(color.black, 50), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 1, displayV1, bgcolor=color.new(color1, 70), text_color=color.white, text_size=size.normal)

    // 2º Lugar
    v2 = array.get(values, 1)
    n2 = array.get(names, 1)
    displayV2 = v2 != -999 ? str.tostring(v2 * 100, "#.##") + "%" : "-"
    color2 = v2 > 0 ? color.green : color.red

    table.cell(panel, 0, 2, n2, bgcolor=color.new(color.black, 50), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 2, displayV2, bgcolor=color.new(color2, 70), text_color=color.white, text_size=size.normal)

    // 3º Lugar
    v3 = array.get(values, 2)
    n3 = array.get(names, 2)
    displayV3 = v3 != -999 ? str.tostring(v3 * 100, "#.##") + "%" : "-"
    color3 = v3 > 0 ? color.green : color.red

    table.cell(panel, 0, 3, n3, bgcolor=color.new(color.black, 50), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 3, displayV3, bgcolor=color.new(color3, 70), text_color=color.white, text_size=size.normal)
