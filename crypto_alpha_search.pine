//@version=5
indicator("Crypto Alpha Search (Manual Input)", shorttitle="Capiba Alpha Search", overlay=true)

// -----------------------------------------------------------------------------
// 1. CONFIGURAÇÃO
// -----------------------------------------------------------------------------
grp_sets = "Configurações"
len = input.int(20, "Período da Média (SMA)", minval=5, group=grp_sets)

grp_assets = "Ativos para Monitorar (Dominância)"
// Usuário define os tickers manualmente. Isso evita erros de "Ticker não encontrado".
t01 = input.symbol("CRYPTOCAP:ETH.D", "Ativo 01", group=grp_assets)
t02 = input.symbol("CRYPTOCAP:BNB.D", "Ativo 02", group=grp_assets)
t03 = input.symbol("CRYPTOCAP:SOL.D", "Ativo 03", group=grp_assets)
t04 = input.symbol("CRYPTOCAP:XRP.D", "Ativo 04", group=grp_assets)
t05 = input.symbol("CRYPTOCAP:ADA.D", "Ativo 05", group=grp_assets)
t06 = input.symbol("CRYPTOCAP:DOGE.D", "Ativo 06", group=grp_assets)
t07 = input.symbol("CRYPTOCAP:AVAX.D", "Ativo 07", group=grp_assets)
t08 = input.symbol("CRYPTOCAP:TRX.D", "Ativo 08", group=grp_assets)

// -----------------------------------------------------------------------------
// 2. FUNÇÃO DE CÁLCULO SAFE
// -----------------------------------------------------------------------------
calc_strength(ticker) =>
    // 'ignore_invalid_symbol' ajuda, mas se o usuário deixar em branco ou errar, lidamos abaixo
    val = request.security(ticker, timeframe.period, close, ignore_invalid_symbol = true)

    // Verificação rigorosa de dados
    valid_val = (not na(val) and val > 0) ? val : 0
    avg       = (valid_val != 0) ? ta.sma(valid_val, len) : 0

    // Retorna -999 se dados inválidos para jogar pro fim da fila
    strength  = (valid_val > 0 and avg > 0) ? (valid_val / avg) - 1 : -999
    strength

// -----------------------------------------------------------------------------
// 3. COLETA DE DADOS
// -----------------------------------------------------------------------------
s01 = calc_strength(t01)
s02 = calc_strength(t02)
s03 = calc_strength(t03)
s04 = calc_strength(t04)
s05 = calc_strength(t05)
s06 = calc_strength(t06)
s07 = calc_strength(t07)
s08 = calc_strength(t08)

// -----------------------------------------------------------------------------
// 4. ORDENAÇÃO (Bubble Sort Manual em Arrays)
// -----------------------------------------------------------------------------
// Arrays fixos de tamanho 8
var names = array.new_string(8)
var values = array.new_float(8)

// Extrai o nome limpo do ticker (Ex: "CRYPTOCAP:ETH.D" -> "ETH")
get_clean_name(ticker_full) =>
    // Tenta pegar a parte entre ':' e '.'
    // Como Pine não tem split fácil de string, vamos simplificar mostrando o ticker user-friendly
    // Ou apenas usar o input direto. Vamos tentar extrair base.
    parts = str.split(ticker_full, ":")
    last_part = array.size(parts) > 0 ? array.get(parts, array.size(parts)-1) : ticker_full
    last_part

if barstate.islast
    array.set(names, 0, get_clean_name(t01))
    array.set(values, 0, s01)
    array.set(names, 1, get_clean_name(t02))
    array.set(values, 1, s02)
    array.set(names, 2, get_clean_name(t03))
    array.set(values, 2, s03)
    array.set(names, 3, get_clean_name(t04))
    array.set(values, 3, s04)
    array.set(names, 4, get_clean_name(t05))
    array.set(values, 4, s05)
    array.set(names, 5, get_clean_name(t06))
    array.set(values, 5, s06)
    array.set(names, 6, get_clean_name(t07))
    array.set(values, 6, s07)
    array.set(names, 7, get_clean_name(t08))
    array.set(values, 7, s08)

    // Bubble Sort (0 a 7)
    for i = 0 to 7
        for j = i + 1 to 7
            if array.get(values, i) < array.get(values, j)
                // Swap
                tempVal = array.get(values, i)
                array.set(values, i, array.get(values, j))
                array.set(values, j, tempVal)

                tempName = array.get(names, i)
                array.set(names, i, array.get(names, j))
                array.set(names, j, tempName)

// -----------------------------------------------------------------------------
// 5. DISPLAY (TABELA)
// -----------------------------------------------------------------------------
// Apenas argumentos obrigatórios para evitar erro de sintaxe
var table panel = table.new(position.top_right, 2, 4)

if barstate.islast
    table.cell(panel, 0, 0, "TOP ALPHA", bgcolor=color.new(color.blue, 30), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 0, "vs SMA" + str.tostring(len), bgcolor=color.new(color.blue, 30), text_color=color.white, text_size=size.normal)

    // Row 1
    v1 = array.get(values, 0)
    n1 = array.get(names, 0)
    txt1 = v1 != -999 ? str.tostring(v1 * 100, "#.##") + "%" : "-"
    c1 = v1 > 0 ? color.green : color.red
    table.cell(panel, 0, 1, n1, bgcolor=color.new(color.black, 50), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 1, txt1, bgcolor=color.new(c1, 70), text_color=color.white, text_size=size.normal)

    // Row 2
    v2 = array.get(values, 1)
    n2 = array.get(names, 1)
    txt2 = v2 != -999 ? str.tostring(v2 * 100, "#.##") + "%" : "-"
    c2 = v2 > 0 ? color.green : color.red
    table.cell(panel, 0, 2, n2, bgcolor=color.new(color.black, 50), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 2, txt2, bgcolor=color.new(c2, 70), text_color=color.white, text_size=size.normal)

    // Row 3
    v3 = array.get(values, 2)
    n3 = array.get(names, 2)
    txt3 = v3 != -999 ? str.tostring(v3 * 100, "#.##") + "%" : "-"
    c3 = v3 > 0 ? color.green : color.red
    table.cell(panel, 0, 3, n3, bgcolor=color.new(color.black, 50), text_color=color.white, text_size=size.normal)
    table.cell(panel, 1, 3, txt3, bgcolor=color.new(c3, 70), text_color=color.white, text_size=size.normal)
