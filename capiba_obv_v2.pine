//@version=5
indicator("Capiba OBV com MAs v2", shorttitle="OBV com MAs v2", overlay=false)

// --- Inputs ---
// Timeframe: Default is chart timeframe ("")
tf = input.timeframe("", title="Timeframe do OBV", group="Configurações Gerais")

// MA 1 Settings (Default: EMA 20)
type1 = input.string("EMA", title="Tipo MA 1", options=["SMA", "EMA"], group="Médias Móveis")
len1 = input.int(20, title="Período MA 1", minval=1, group="Médias Móveis")

// MA 2 Settings (Default: EMA 200)
type2 = input.string("EMA", title="Tipo MA 2", options=["SMA", "EMA"], group="Médias Móveis")
len2 = input.int(200, title="Período MA 2", minval=1, group="Médias Móveis")

// Divergence Settings
pivot_len = input.int(5, title="Período de Pivot (Divergências)", minval=1, group="Divergências", tooltip="Período de verificação para encontrar topos e fundos reais.")

// --- Calculation ---

// Helper function to select MA type
get_ma(src, type, len) =>
    type == "SMA" ? ta.sma(src, len) : ta.ema(src, len)

// Function to calculate OBV and MAs in the requested timeframe context
calc_data() =>
    // Standard On Balance Volume
    _obv = ta.obv
    // Calculate MAs based on that OBV
    _ma1 = get_ma(_obv, type1, len1)
    _ma2 = get_ma(_obv, type2, len2)
    [_obv, _ma1, _ma2]

// request.security to get data from the chosen timeframe
[v_obv, v_ma1, v_ma2] = request.security(syminfo.tickerid, tf, calc_data())

// --- Coloração Dinâmica do OBV ---
color_bullish = #006400 // Dark Green
color_bearish = #8B0000 // Dark Red
color_divergent = color.orange

obvColor = if (v_obv > v_ma1 and v_ma1 > v_ma2)
    color_bullish
else if (v_obv < v_ma1 and v_ma1 < v_ma2)
    color_bearish
else
    color_divergent

// --- Detecção Explícita de Divergências (Price vs OBV) ---
// Global scope calculation for pivot points
ph_valid = not na(ta.pivothigh(high, pivot_len, pivot_len))
pl_valid = not na(ta.pivotlow(low, pivot_len, pivot_len))

var float prev_price_ph = na
var float prev_obv_ph   = na
var float prev_price_pl = na
var float prev_obv_pl   = na

bullDiv = false
bearDiv = false

if ph_valid
    curr_price_ph = high[pivot_len]
    curr_obv_ph   = v_obv[pivot_len]
    if not na(prev_price_ph) and curr_price_ph > prev_price_ph and curr_obv_ph < prev_obv_ph
        bearDiv := true
    prev_price_ph := curr_price_ph
    prev_obv_ph   := curr_obv_ph

if pl_valid
    curr_price_pl = low[pivot_len]
    curr_obv_pl   = v_obv[pivot_len]
    if not na(prev_price_pl) and curr_price_pl < prev_price_pl and curr_obv_pl > prev_obv_pl
        bullDiv := true
    prev_price_pl := curr_price_pl
    prev_obv_pl   := curr_obv_pl

// --- Plotting ---
// MA 2: White, Width 1, Dashed (Simulated with circles since dashed isn't an option for plot dynamic style if it were dynamic, but since it's fixed we can use style_circles or cross)
plot(v_ma2, title="MA 2 (200)", color=color.white, linewidth=1, style=plot.style_circles)

// MA 1: Light Yellow, Width 2
plot(v_ma1, title="MA 1 (20)", color=color.new(color.yellow, 30), linewidth=2)

// OBV: Dynamic color, Width 2
plot(v_obv, title="OBV", color=obvColor, linewidth=2)

// Divergence plots
plotshape(bullDiv ? v_obv[pivot_len] : na, title="Bullish Divergence", style=shape.labelup,   location=location.absolute, color=color.green, size=size.tiny, offset=-pivot_len, text="DIV", textcolor=color.white)
plotshape(bearDiv ? v_obv[pivot_len] : na, title="Bearish Divergence", style=shape.labeldown, location=location.absolute, color=color.red,   size=size.tiny, offset=-pivot_len, text="DIV", textcolor=color.white)
