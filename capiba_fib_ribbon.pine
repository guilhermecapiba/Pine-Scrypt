//@version=6
indicator("Capiba Fibonacci Ribbon Pro", shorttitle="Capiba Fib Ribbon", overlay=true)

// =========================================================================
// 1. INPUTS
// =========================================================================
grp_ma = "Configurações das Médias"
ma_src = input.source(close, "Fonte de Dados", group=grp_ma)
ma_type_fast = input.string("EMA", "Tipo MAs Gatilho/Tendência", options=["SMA", "EMA", "RMA", "WMA", "VWMA", "HMA"], group=grp_ma)
ma_type_slow = input.string("SMA", "Tipo MAs Institucionais", options=["SMA", "EMA", "RMA", "WMA", "VWMA", "HMA"], group=grp_ma)

grp_vis = "Visualização e Cores"
show_ribbons = input.bool(true, "Mostrar Fitas (Preenchimento)", group=grp_vis)
color_candles = input.bool(true, "Colorir Velas por Fase", group=grp_vis)
show_squeeze = input.bool(true, "Destacar Zonas de Squeeze (Compressão)", group=grp_vis)
show_signals = input.bool(true, "Mostrar Sinais de Exaustão (3x13)", group=grp_vis)

// =========================================================================
// 2. FUNÇÕES BASE
// =========================================================================
get_ma(src, length, type) =>
    switch type
        "SMA" => ta.sma(src, length)
        "EMA" => ta.ema(src, length)
        "RMA" => ta.rma(src, length)
        "WMA" => ta.wma(src, length)
        "VWMA" => ta.vwma(src, length)
        "HMA" => ta.hma(src, length)
        => ta.sma(src, length)

// =========================================================================
// 3. CÁLCULO DAS CAMADAS (FIBONACCI)
// =========================================================================
// A) Gatilho de Reversão (3, 5, 8, 13) - Sentimento Imediato
ma03 = get_ma(ma_src, 3, ma_type_fast)
ma05 = get_ma(ma_src, 5, ma_type_fast)
ma08 = get_ma(ma_src, 8, ma_type_fast)
ma13 = get_ma(ma_src, 13, ma_type_fast)

// B) Corpo da Tendência (21, 34, 55) - Varejo / Algoritmos
ma21 = get_ma(ma_src, 21, ma_type_fast)
ma34 = get_ma(ma_src, 34, ma_type_fast)
ma55 = get_ma(ma_src, 55, ma_type_fast)

// C) Âncora Institucional (89, 144, 233) - Smart Money / Ciclo
ma89  = get_ma(ma_src, 89, ma_type_slow)
ma144 = get_ma(ma_src, 144, ma_type_slow)
ma233 = get_ma(ma_src, 233, ma_type_slow)

// =========================================================================
// 4. PLOTS E ESTILIZAÇÃO VISUAL
// =========================================================================
// Cores Camada 1: Vibrantes (Amarelo/Ciano)
c_ma03 = color.new(#FFFF00, 0) // Amarelo
c_ma05 = color.new(#FFEA00, 0) // Amarelo alaranjado
c_ma08 = color.new(#00FFFF, 0) // Ciano claro
c_ma13 = color.new(#00B8D4, 0) // Ciano escuro

// Cores Camada 2: Gradiente Verde
c_ma21 = color.new(#64DD17, 0) // Verde claro
c_ma34 = color.new(#00C853, 0) // Verde médio
c_ma55 = color.new(#1B5E20, 0) // Verde escuro

// Cores Camada 3: Sóbrias
c_ma89  = color.new(#880E4F, 0) // Bordô
c_ma144 = color.new(#4A148C, 0) // Roxo Escuro / Anil
c_ma233 = color.new(#1A237E, 0) // Azul Marinho

// Plots
p03 = plot(ma03, color=c_ma03, linewidth=1, title="MA 3 Gatilho")
p05 = plot(ma05, color=c_ma05, linewidth=1, title="MA 5")
p08 = plot(ma08, color=c_ma08, linewidth=1, title="MA 8")
p13 = plot(ma13, color=c_ma13, linewidth=2, title="MA 13 Exaustão")

p21 = plot(ma21, color=c_ma21, linewidth=1, title="MA 21 Tendência")
p34 = plot(ma34, color=c_ma34, linewidth=1, title="MA 34")
p55 = plot(ma55, color=c_ma55, linewidth=2, title="MA 55 Limite Tendência")

p89  = plot(ma89,  color=c_ma89,  linewidth=2, title="MA 89 Âncora Curta")
p144 = plot(ma144, color=c_ma144, linewidth=3, title="MA 144 Âncora STH")
p233 = plot(ma233, color=c_ma233, linewidth=4, title="MA 233 Stop Ciclo")

// Fills (Fitas)
fill(p03, p13, color=show_ribbons ? color.new(c_ma13, 85) : na, title="Ribbon Gatilho")
fill(p21, p55, color=show_ribbons ? color.new(c_ma34, 85) : na, title="Ribbon Tendência")
fill(p89, p233, color=show_ribbons ? color.new(c_ma144, 85) : na, title="Ribbon Institucional")

// =========================================================================
// 5. LÓGICA DE DETECÇÃO (SQUEEZE, FASES, SINAIS)
// =========================================================================
// A) Detecção de Squeeze (Compressão 3 ao 55)
// Se a distância entre a média mais rápida (3) e a base da tendência (55) for muito pequena
atr = ta.atr(14)
dist_3_55 = math.abs(ma03 - ma55)
is_squeeze = dist_3_55 < (atr * 0.4) // Threshold de agrupamento

bgcolor(show_squeeze and is_squeeze ? color.new(color.yellow, 90) : na, title="Fundo Squeeze")

// B) Lógica de Fases de Mercado para Coloração de Velas
// 1. Alta Forte: Preço > 21 > 55 > 144
is_strong_bull = close > ma21 and ma21 > ma55 and ma55 > ma144

// 2. Zona de Compra (Discount): Preço retorna entre 89 e 144
is_buy_zone = close <= ma89 and close >= ma144 and ma144 > ma233

// 3. Reversão de Topo: Médias curtas curvam pra baixo com preço acima da 144
short_curving_down = ta.falling(ma03, 2) and ta.falling(ma05, 2) and ta.falling(ma08, 1)
is_top_reversion = short_curving_down and close > ma144 and ma13 > ma55

// 4. Bear Market (Stop de Ciclo): Preço perde a 233
is_bear_market = close < ma233

// Definir a cor da vela baseada na hierarquia
c_vela = is_bear_market ? color.new(#FF5252, 0) : // Vermelho: Bear Market
         is_top_reversion ? color.new(#FFA726, 0) : // Laranja: Exaustão/Topo
         is_buy_zone ? color.new(#29B6F6, 0) : // Azul: Deep Discount
         is_strong_bull ? color.new(#69F0AE, 0) : // Verde: Alta Forte
         color.new(color.gray, 30) // Neutro

barcolor(color_candles ? c_vela : na, title="Coloração de Velas")

// C) Gatilhos de Exaustão (Cruzamento 3 com 13)
cross_3_13_up = ta.crossover(ma03, ma13)
cross_3_13_dn = ta.crossunder(ma03, ma13)

plotshape(show_signals and cross_3_13_up, style=shape.triangleup, location=location.belowbar, color=c_ma03, size=size.small, title="Sinal Alta 3x13")
plotshape(show_signals and cross_3_13_dn, style=shape.triangledown, location=location.abovebar, color=color.new(#FFA726, 0), size=size.small, title="Sinal Baixa 3x13")
