//@version=6
indicator("Capiba Fibonacci Ribbon Pro", shorttitle="Capiba Fib Ribbon", overlay=true)

// =========================================================================
// 1. INPUTS
// =========================================================================
grp_ma = "Configurações das Médias"
ma_src = input.source(close, "Fonte de Dados", group=grp_ma)
ma_type_fast = input.string("SMA", "Tipo MAs Gatilho/Tendência", options=["SMA", "EMA", "RMA", "WMA", "VWMA", "HMA"], group=grp_ma)
ma_type_slow = input.string("SMA", "Tipo MAs Institucionais", options=["SMA", "EMA", "RMA", "WMA", "VWMA", "HMA"], group=grp_ma)

grp_vis = "Visualização e Cores"
show_ribbons = input.bool(true, "Mostrar Fitas (Preenchimento)", group=grp_vis)
color_candles = input.bool(true, "Colorir Velas por Fase", group=grp_vis)
show_bg = input.bool(true, "Colorir Fundo (Background)", group=grp_vis)
show_signals = input.bool(true, "Mostrar Sinais de Exaustão (3x13)", group=grp_vis)
show_table = input.bool(true, "Mostrar Tabela Informativa", group=grp_vis)

// =========================================================================
// 2. FUNÇÕES BASE
// =========================================================================
get_ma(src, length, type) =>
    switch type
        "SMA" => ta.sma(src, length)
        "EMA" => ta.ema(src, length)
        "RMA" => ta.rma(src, length)
        "WMA" => ta.wma(src, length)
        "VWMA" => ta.vwma(src, length)
        "HMA" => ta.hma(src, length)
        => ta.sma(src, length)

// =========================================================================
// 3. CÁLCULO DAS CAMADAS (FIBONACCI)
// =========================================================================
// A) Gatilho de Reversão (3, 5, 8, 13)
ma03 = get_ma(ma_src, 3, ma_type_fast)
ma05 = get_ma(ma_src, 5, ma_type_fast)
ma08 = get_ma(ma_src, 8, ma_type_fast)
ma13 = get_ma(ma_src, 13, ma_type_fast)

// B) Corpo da Tendência (21, 34, 55)
ma21 = get_ma(ma_src, 21, ma_type_fast)
ma34 = get_ma(ma_src, 34, ma_type_fast)
ma55 = get_ma(ma_src, 55, ma_type_fast)

// C) Âncora Institucional (89, 144, 233)
ma89  = get_ma(ma_src, 89, ma_type_slow)
ma144 = get_ma(ma_src, 144, ma_type_slow)
ma233 = get_ma(ma_src, 233, ma_type_slow)

// =========================================================================
// 4. PLOTS E ESTILIZAÇÃO VISUAL (LEQUES SIMPLIFICADOS)
// =========================================================================
// Leque 1: Ciano (Curto Prazo)
c_layer1 = color.new(#00BCD4, 0)
// Leque 2: Laranja (Médio Prazo)
c_layer2 = color.new(#FF9800, 0)
// Leque 3: Roxo (Longo Prazo)
c_layer3 = color.new(#9C27B0, 0)

// Plots
p03 = plot(ma03, color=color.new(c_layer1, 40), linewidth=1)
p05 = plot(ma05, color=color.new(c_layer1, 20), linewidth=1)
p08 = plot(ma08, color=color.new(c_layer1, 0),  linewidth=1)
p13 = plot(ma13, color=color.new(c_layer1, 0),  linewidth=2, title="MA 13")

p21 = plot(ma21, color=color.new(c_layer2, 40), linewidth=1)
p34 = plot(ma34, color=color.new(c_layer2, 20), linewidth=1)
p55 = plot(ma55, color=color.new(c_layer2, 0),  linewidth=2, title="MA 55")

p89  = plot(ma89,  color=color.new(c_layer3, 40), linewidth=2)
p144 = plot(ma144, color=color.new(c_layer3, 20), linewidth=3)
p233 = plot(ma233, color=color.new(c_layer3, 0),  linewidth=4, title="MA 233")

// Fitas
fill(p03, p13, color=show_ribbons ? color.new(c_layer1, 85) : na, title="Fita Curta")
fill(p21, p55, color=show_ribbons ? color.new(c_layer2, 85) : na, title="Fita Média")
fill(p89, p233, color=show_ribbons ? color.new(c_layer3, 85) : na, title="Fita Longa")

// =========================================================================
// 5. LÓGICA DE FASES, COLORAÇÃO E SINAIS
// =========================================================================
// Definição das Condições
// Topo: Preço muito esticado acima da MA rápida e caindo
is_top = close > ma03 and ta.falling(ma03, 1) and close > ma55
// Alta: Preço subindo acima das MAs de tendência
is_bull = close > ma21 and ma21 > ma55
// Fundo: Preço abaixo da MA 233 (Deep Discount) ou retornando nela
is_bottom = close < ma233 or (close >= ma233 and close <= ma144 and ta.rising(close, 1))
// Baixa: Preço caindo abaixo das MAs de tendência
is_bear = close < ma55 and ma21 < ma55
// Neutro/Squeeze
atr = ta.atr(14)
is_squeeze = math.abs(ma03 - ma55) < (atr * 0.4)

// A) Coloração de Velas
c_vela = is_top ? color.new(color.blue, 0) :
         is_bottom ? color.new(color.yellow, 0) :
         is_bull ? color.new(color.green, 0) :
         is_bear ? color.new(color.red, 0) :
         color.new(color.white, 0)

barcolor(color_candles ? c_vela : na, title="Cores das Velas")

// B) Coloração de Fundo (Background)
// Compra = Verde (Retorno em Fundo/Alta), Venda = Vermelho (Topo/Baixa Forte), Neutro/Squeeze = Cinza
c_bg = is_bottom ? color.new(color.green, 90) :
       is_squeeze ? color.new(color.gray, 90) :
       is_top ? color.new(color.red, 90) :
       na

bgcolor(show_bg ? c_bg : na, title="Cor de Fundo")

// C) Sinais de Cruzamento 3x13
cross_up = ta.crossover(ma03, ma13)
cross_dn = ta.crossunder(ma03, ma13)
plotshape(show_signals and cross_up, style=shape.triangleup, location=location.belowbar, color=color.new(color.green,0), size=size.small)
plotshape(show_signals and cross_dn, style=shape.triangledown, location=location.abovebar, color=color.new(color.red,0), size=size.small)

// =========================================================================
// 6. TABELA INFORMATIVA (DASHBOARD)
// =========================================================================
var table info_table = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_width=1)

if barstate.islast and show_table
    // Linha 1: Cabeçalho
    table.cell(info_table, 0, 0, "Status Geral do Mercado", text_color=color.white, text_size=size.normal)
    table.cell(info_table, 1, 0, "Sinal", text_color=color.white, text_size=size.normal)

    // Linha 2: Fase e Cor da Vela
    txt_fase = is_top ? "Zona de Topo (Exaustão)" : is_bottom ? "Zona de Fundo (Desconto)" : is_bull ? "Tendência de Alta" : is_bear ? "Tendência de Baixa" : "Neutro / Lateral"
    table.cell(info_table, 0, 1, "Fase Atual:", text_color=color.white)
    table.cell(info_table, 1, 1, txt_fase, text_color=c_vela, bgcolor=color.new(c_vela, 80))

    // Linha 3: Background Explicado
    txt_bg = is_bottom ? "Oportunidade de Compra" : is_squeeze ? "Compressão (Aguarde o Rompimento)" : is_top ? "Risco de Queda (Realize Lucros)" : "Seguir a Tendência"
    c_txt_bg = is_bottom ? color.green : is_squeeze ? color.gray : is_top ? color.red : color.white
    table.cell(info_table, 0, 2, "Ação Sugerida:", text_color=color.white)
    table.cell(info_table, 1, 2, txt_bg, text_color=c_txt_bg)

    // Linha 4: MAs Principais
    txt_mas = "MA 55: " + str.tostring(math.round(ma55,2)) + " | MA 233: " + str.tostring(math.round(ma233,2))
    table.cell(info_table, 0, 3, "Níveis Chave:", text_color=color.white)
    table.cell(info_table, 1, 3, txt_mas, text_color=color.silver)
