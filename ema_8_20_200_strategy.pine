//@version=6
strategy("Backtest EMAs 8/20/200", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// =========================================================================
// 1. INPUTS
// =========================================================================
len8   = input.int(8, title="EMA Curta")
len20  = input.int(20, title="EMA Média")
len200 = input.int(200, title="EMA Longa")

// =========================================================================
// 2. CÁLCULOS DAS EMAS
// =========================================================================
ema8   = ta.ema(close, len8)
ema20  = ta.ema(close, len20)
ema200 = ta.ema(close, len200)

// =========================================================================
// 3. PLOTS NO GRÁFICO (Visualização)
// =========================================================================
plot(ema8, color=color.green, title="EMA 8", linewidth=2)
plot(ema20, color=color.yellow, title="EMA 20", linewidth=2)
plot(ema200, color=color.white, title="EMA 200", linewidth=3)

// =========================================================================
// 4. LÓGICA DE ALINHAMENTO
// =========================================================================
// Verifica se as EMAs estão alinhadas
long_aligned  = (ema8 > ema20) and (ema20 > ema200)
short_aligned = (ema8 < ema20) and (ema20 < ema200)

// =========================================================================
// 5. EXECUÇÃO DE ORDENS
// =========================================================================

// ENTRADAS
// Compra: EMA 8 cruza acima da 20 E a 20 já está acima da 200
if ta.crossover(ema8, ema20) and (ema20 > ema200)
    strategy.entry("Compra", strategy.long)

// Venda: EMA 8 cruza abaixo da 20 E a 20 já está abaixo da 200
if ta.crossunder(ema8, ema20) and (ema20 < ema200)
    strategy.entry("Venda", strategy.short)

// SAÍDAS
// Fecha a posição comprada se o alinhamento de alta for quebrado
if strategy.position_size > 0 and not long_aligned
    strategy.close("Compra", comment="Fim Alinhamento Alta")

// Fecha a posição vendida se o alinhamento de baixa for quebrado
if strategy.position_size < 0 and not short_aligned
    strategy.close("Venda", comment="Fim Alinhamento Baixa")
