//@version=5
indicator("OBV / Preço", shorttitle="OBV/P", overlay=false)

// Cálculo do OBV padrão (On-Balance Volume)
obv = ta.cum(math.sign(ta.change(close)) * volume)

// Cálculo da nova métrica (OBV / Preço)
obv_price = obv / close

// Inputs para a Média Móvel
ma_type = input.string("EMA", title="Tipo de MA", options=["SMA", "EMA", "RMA", "WMA", "VWMA", "HMA"])
ma_length = input.int(20, title="Período da MA", minval=1)
ma_color = input.color(color.white, title="Cor da MA")
ma_width = input.int(2, title="Espessura da MA", minval=1, maxval=4)

// Opções de Estilo da Linha
ma_style_str = input.string("Line", title="Estilo da Linha da MA", options=["Line", "Stepline", "Histogram", "Cross", "Area", "Columns", "Circles"])

// Função para calcular a Média Móvel selecionada
get_ma(source, length, type) =>
    type == "SMA" ? ta.sma(source, length) : type == "EMA" ? ta.ema(source, length) : type == "RMA" ? ta.rma(source, length) : type == "WMA" ? ta.wma(source, length) : type == "VWMA" ? ta.vwma(source, length) : type == "HMA" ? ta.hma(source, length) : na

// Cálculo da MA sobre a métrica OBV/Preço
ma_value = get_ma(obv_price, ma_length, ma_type)

// Plotagem da nova métrica (OBV / Preço) em vez da linha OBV
plot(obv_price, title="OBV / Preço", color=color.blue, linewidth=2)

// Plotagem da Média Móvel usando múltiplos plots para contornar o tipo const int no parâmetro style do PineScript v5
plot(ma_style_str == "Line" ? ma_value : na, title="MA (Line)", color=ma_color, linewidth=ma_width, style=plot.style_line)
plot(ma_style_str == "Stepline" ? ma_value : na, title="MA (Stepline)", color=ma_color, linewidth=ma_width, style=plot.style_stepline)
plot(ma_style_str == "Histogram" ? ma_value : na, title="MA (Histogram)", color=ma_color, linewidth=ma_width, style=plot.style_histogram)
plot(ma_style_str == "Cross" ? ma_value : na, title="MA (Cross)", color=ma_color, linewidth=ma_width, style=plot.style_cross)
plot(ma_style_str == "Area" ? ma_value : na, title="MA (Area)", color=ma_color, linewidth=ma_width, style=plot.style_area)
plot(ma_style_str == "Columns" ? ma_value : na, title="MA (Columns)", color=ma_color, linewidth=ma_width, style=plot.style_columns)
plot(ma_style_str == "Circles" ? ma_value : na, title="MA (Circles)", color=ma_color, linewidth=ma_width, style=plot.style_circles)
