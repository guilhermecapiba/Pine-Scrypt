//@version=5
indicator("BTC x USD Dominance Ratio v2", shorttitle="BTC Dom v2", overlay=false)

// Symbols
sym_price_default = "BINANCE:BTCUSDT"
sym_btc_d_default = "CRYPTOCAP:BTC.D"
sym_usdt_d_default = "CRYPTOCAP:USDT.D"
sym_usdc_d_default = "CRYPTOCAP:USDC.D"

sym_price = input.symbol(sym_price_default, "BTC Price Symbol (for Divergence)")
sym_btc_d = input.symbol(sym_btc_d_default, "BTC Dominance Symbol")
sym_usdt_d = input.symbol(sym_usdt_d_default, "USDT Dominance Symbol")
sym_usdc_d = input.symbol(sym_usdc_d_default, "USDC Dominance Symbol")

// Fetch data
// We need High and Low of Price for divergence detection
[price_c, price_h, price_l] = request.security(sym_price, timeframe.period, [close, high, low])

btc_d = request.security(sym_btc_d, timeframe.period, close)
usdt_d = request.security(sym_usdt_d, timeframe.period, close)
usdc_d = request.security(sym_usdc_d, timeframe.period, close)

// Formula: BTC.D / (USDT.D + USDC.D)
stable_sum = usdt_d + usdc_d
main_value = stable_sum != 0 ? (btc_d / stable_sum) : 0

// EMA 20
ema_length = input.int(20, title="EMA Length")
ema_value = ta.ema(main_value, ema_length)

// EMA 200
ema200_length = input.int(200, title="EMA 200 Length")
ema200_value = ta.ema(main_value, ema200_length)

// Plotting
plot(main_value, title="Main Line", color=color.blue, linewidth=2)
plot(ema_value, title="EMA 20", color=color.orange, linewidth=2)
plot(ema200_value, title="EMA 200", color=color.red, linewidth=2)

//===== DIVERGENCE DETECTION =====
string groupDiv = "Divergence Detection"
showDivergences = input.bool(true, "Show Divergences?", group = groupDiv)
pivotLeft = input.int(5, "Pivot Lookback Left", minval = 1, group = groupDiv)
pivotRight = input.int(5, "Pivot Lookback Right", minval = 1, group = groupDiv)
bullishDivColor = input.color(color.new(color.green, 0), "Bullish Color", inline="bull", group = groupDiv)
bullishLineWidth = input.int(2, "Line Width", minval=1, inline="bull", group=groupDiv)
bearishDivColor = input.color(color.new(color.red, 0), "Bearish Color", inline="bear", group = groupDiv)
bearishLineWidth = input.int(2, "Line Width", minval=1, inline="bear", group=groupDiv)

// Calculate Pivots
pivotHighInd = ta.pivothigh(main_value, pivotLeft, pivotRight)
pivotLowInd = ta.pivotlow(main_value, pivotLeft, pivotRight)

if showDivergences
    // We compare the Indicator (main_value) pivots vs the Price (price_h / price_l) pivots

    // --- BEARISH DIVERGENCE ---
    // Price makes Higher High, Indicator makes Lower High
    if not na(pivotHighInd)
        // Find previous pivot high of indicator
        prevPivotHighInd_val = ta.valuewhen(not na(pivotHighInd), main_value, 1)
        // Find price at that previous pivot moment
        prevPivotHigh_price = ta.valuewhen(not na(pivotHighInd), price_h, 1)
        // Find bar index
        prevPivotHigh_bar = ta.valuewhen(not na(pivotHighInd), bar_index, 1)

        // Comparison
        // Current pivot price (price_h) > Previous pivot price
        // Current pivot indicator (main_value) < Previous pivot indicator
        if price_h > prevPivotHigh_price and main_value < prevPivotHighInd_val
            line.new(prevPivotHigh_bar, prevPivotHighInd_val, bar_index, main_value, color=bearishDivColor, width=bearishLineWidth)

    // --- BULLISH DIVERGENCE ---
    // Price makes Lower Low, Indicator makes Higher Low
    if not na(pivotLowInd)
        // Find previous pivot low of indicator
        prevPivotLowInd_val = ta.valuewhen(not na(pivotLowInd), main_value, 1)
        // Find price at that previous pivot moment
        prevPivotLow_price = ta.valuewhen(not na(pivotLowInd), price_l, 1)
        // Find bar index
        prevPivotLow_bar = ta.valuewhen(not na(pivotLowInd), bar_index, 1)

        // Comparison
        // Current pivot price (price_l) < Previous pivot price
        // Current pivot indicator (main_value) > Previous pivot indicator
        if price_l < prevPivotLow_price and main_value > prevPivotLowInd_val
            line.new(prevPivotLow_bar, prevPivotLowInd_val, bar_index, main_value, color=bullishDivColor, width=bullishLineWidth)

//===== STRUCTURE BREAKS =====
string groupBreak = "Structure Breaks"
showBreakouts = input.bool(true, "Show Structure Breaks?", group = groupBreak)

var float lastPivotHigh = na
var float lastPivotLow = na

if not na(pivotHighInd)
    lastPivotHigh := pivotHighInd

if not na(pivotLowInd)
    lastPivotLow := pivotLowInd

bullishBreak = showBreakouts and not na(lastPivotHigh) and ta.crossover(main_value, lastPivotHigh)
bearishBreak = showBreakouts and not na(lastPivotLow) and ta.crossunder(main_value, lastPivotLow)

plotchar(bullishBreak ? lastPivotHigh : na, title="Bullish Break", char="▲", location=location.absolute, color=color.green, size=size.tiny, text="BOS", textcolor=color.green, offset=0)
plotchar(bearishBreak ? lastPivotLow : na, title="Bearish Break", char="▼", location=location.absolute, color=color.red, size=size.tiny, text="BOS", textcolor=color.red, offset=0)
