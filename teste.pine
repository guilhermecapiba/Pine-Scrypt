//@version=5
indicator("Teste", overlay=true)

// --- 1. PROXY DE LIQUIDEZ EM TEMPO REAL ---
// Usamos o Stablecoin Ratio (SSR) invertido como proxy de liquidez
// Se o SSR cai, o poder de compra das stables aumenta (Liquidez Sobe)
// FIX: Splitting security call and using standard tickers
// Assuming CRYPTO:BTCUSD is generic, but BINANCE:BTCUSDT is safer for volume/price.
// CRYPTO:USDT.MC -> CRYPTOCAP:USDT
// CRYPTO:USDC.MC -> CRYPTOCAP:USDC
btc = request.security("BINANCE:BTCUSDT", "D", close)
usdt_mc = request.security("CRYPTOCAP:USDT", "D", close)
usdc_mc = request.security("CRYPTOCAP:USDC", "D", close)

ssr = btc / (usdt_mc + usdc_mc)

ssr_ma = ta.sma(ssr, 10)
liquidez_agil = ssr < ssr_ma // Poder de compra aumentando

// --- 2. MOMENTUM E VOLATILIDADE (VELEZ) ---
ma20 = ta.sma(close, 20)
distancia_ma20 = (close - ma20) / ma20 * 100
atr = ta.atr(14)

// --- 3. GESTÃO DE ALAVANCAGEM DINÂMICA ---
float lev = 1.0
color sinal_cor = color.gray
vwap_val = ta.vwap(close) // FIX: Added source

if close > ma20 and liquidez_agil
    lev := 1.1
    if ta.crossover(close, ta.highest(high, 10)[1]) // Rompimento de máxima recente
        lev := 1.3
        if close > vwap_val and distancia_ma20 < 5 // Evita alavancar no topo (Velez)
            lev := 1.5

// Sinal de Perigo: Preço cai + Volatilidade sobe
if close < ma20 or ta.atr(5) > ta.atr(20) * 1.5
    lev := 1.0

// --- 4. DISPLAY NO GRÁFICO ---
var table log_table = table.new(position.top_right, 2, 2, bgcolor = color.black, border_width = 1)
table.cell(log_table, 0, 0, "Alavancagem Sugerida:", text_color = color.white)
table.cell(log_table, 1, 0, str.tostring(lev) + "x", text_color = lev > 1.0 ? color.green : color.red)

// SINALIZAÇÃO VISUAL: Linhas Verticais e Texto
alavancar_cond = ta.crossover(lev, 1.1) // Trigger when leverage increases past 1.1
desalavancar_cond = lev < lev[1]

if alavancar_cond
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.new(color.green, 50), style=line.style_dashed, width=1)
    label.new(bar_index, high, "ALAVANCAR\nLEV " + str.tostring(lev) + "x", color=color.green, textcolor=color.white, style=label.style_label_down)

if desalavancar_cond
    line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.new(color.red, 50), style=line.style_dashed, width=1)
    label.new(bar_index, low, "REDUZIR", color=color.red, textcolor=color.white, style=label.style_label_up)
