//@version=5
// DONCHIAN_20_10 | BTC 1D | rompimento da maxima de 20 barras, saida na minima de 10 barras (Turtle curto)
// Origem: HYP-Q047 (reservada). Candidata promissora: passa na regua minima do BENCHMARK da 08_CONFIG.
// Convencao do backtest padronizado (identica a usada para comparar com a planilha MVP):
// sinal avaliado no fechamento, execucao na abertura da barra seguinte (padrao TradingView),
// long only, 100% do capital, comissao 0.125% por lado, slippage 0, historico a partir de 2015-07-20.
// Metricas esperadas e racional: RELATORIO_REFINO_BTC_1D.md
strategy("DONCHIAN_20_10 BTC 1D", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.125, slippage=0, pyramiding=0)
nIn   = input.int(20, "Entrada: maxima de N barras", minval=2)
nOut  = input.int(10, "Saida: minima de M barras", minval=2)
start = input.time(timestamp("2015-07-20 00:00 +0000"), "Inicio do backtest")
inRange = time >= start

upper = ta.highest(high, nIn)[1]
lower = ta.lowest(low, nOut)[1]

longEntry = inRange and close > upper
longExit  = close < lower

if longEntry and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if longExit and strategy.position_size > 0
    strategy.close("Long", comment="Saida Donchian")

plot(upper, "Maxima N (entrada)", color=color.new(color.green, 0))
plot(lower, "Minima M (saida)", color=color.new(color.red, 0))
