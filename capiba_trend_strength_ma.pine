//@version=6
indicator("Capiba Trend Strength MA", overlay=true, shorttitle="CapibaTSMA")

// --- Inputs ---
string grp_main = "Main Settings"
string maType = input.string("EMA", "MA Type", options=["SMA", "EMA", "WMA", "VWMA", "RMA", "HMA"], group=grp_main)
// We use close as source.
float src = input.source(close, "Source", group=grp_main)

string grp_ma = "MA Settings"
bool show_3 = input.bool(false, "Show MA 3", group=grp_ma, inline="ma3")
color col_3 = input.color(color.new(color.gray, 0), "", group=grp_ma, inline="ma3")

bool show_5 = input.bool(false, "Show MA 5", group=grp_ma, inline="ma5")
color col_5 = input.color(color.new(color.gray, 0), "", group=grp_ma, inline="ma5")

bool show_8 = input.bool(false, "Show MA 8", group=grp_ma, inline="ma8")
color col_8 = input.color(color.new(color.gray, 0), "", group=grp_ma, inline="ma8")

bool show_13 = input.bool(false, "Show MA 13", group=grp_ma, inline="ma13")
color col_13 = input.color(color.new(color.gray, 0), "", group=grp_ma, inline="ma13")

bool show_21 = input.bool(true, "Show MA 21", group=grp_ma, inline="ma21")
color col_21 = input.color(color.new(color.teal, 0), "", group=grp_ma, inline="ma21")

bool show_34 = input.bool(false, "Show MA 34", group=grp_ma, inline="ma34")
color col_34 = input.color(color.new(color.fuchsia, 0), "", group=grp_ma, inline="ma34")

bool show_55 = input.bool(true, "Show MA 55", group=grp_ma, inline="ma55")
color col_55 = input.color(color.new(color.orange, 0), "", group=grp_ma, inline="ma55")

bool show_89 = input.bool(true, "Show MA 89", group=grp_ma, inline="ma89")
color col_89 = input.color(color.new(color.red, 0), "", group=grp_ma, inline="ma89")

bool show_144 = input.bool(false, "Show MA 144", group=grp_ma, inline="ma144")
color col_144 = input.color(color.new(color.purple, 0), "", group=grp_ma, inline="ma144")

bool show_233 = input.bool(true, "Show MA 233", group=grp_ma, inline="ma233")
color col_233 = input.color(color.new(color.white, 0), "", group=grp_ma, inline="ma233")

string grp_dash = "Dashboard"
bool show_dashboard = input.bool(true, "Show Dashboard", group=grp_dash)

// --- Functions ---
get_ma(type, source, len) =>
    float ma = switch type
        "SMA" => ta.sma(source, len)
        "EMA" => ta.ema(source, len)
        "WMA" => ta.wma(source, len)
        "VWMA" => ta.vwma(source, len)
        "RMA" => ta.rma(source, len)
        "HMA" => ta.hma(source, len)
        => ta.ema(source, len)
    ma

// --- Calculations ---
float ma_3 = get_ma(maType, src, 3)
float ma_5 = get_ma(maType, src, 5)
float ma_8 = get_ma(maType, src, 8)
float ma_13 = get_ma(maType, src, 13)
float ma_21 = get_ma(maType, src, 21)
float ma_34 = get_ma(maType, src, 34)
float ma_55 = get_ma(maType, src, 55)
float ma_89 = get_ma(maType, src, 89)
float ma_144 = get_ma(maType, src, 144)
float ma_233 = get_ma(maType, src, 233)

plot(show_3 ? ma_3 : na, color=col_3, title="MA 3", linewidth=1)
plot(show_5 ? ma_5 : na, color=col_5, title="MA 5", linewidth=1)
plot(show_8 ? ma_8 : na, color=col_8, title="MA 8", linewidth=1)
plot(show_13 ? ma_13 : na, color=col_13, title="MA 13", linewidth=1)
plot(show_21 ? ma_21 : na, color=col_21, title="MA 21", linewidth=2)
plot(show_34 ? ma_34 : na, color=col_34, title="MA 34", linewidth=2)
plot(show_55 ? ma_55 : na, color=col_55, title="MA 55", linewidth=2)
plot(show_89 ? ma_89 : na, color=col_89, title="MA 89", linewidth=2)
plot(show_144 ? ma_144 : na, color=col_144, title="MA 144", linewidth=2)
plot(show_233 ? ma_233 : na, color=col_233, title="MA 233", linewidth=3)

// --- Scoring Logic ---
int score_3 = ma_3 > ma_3[1] ? 2 : (ma_3 < ma_3[1] ? -2 : 0)
int score_5 = ma_5 > ma_5[1] ? 3 : (ma_5 < ma_5[1] ? -3 : 0)
int score_8 = ma_8 > ma_8[1] ? 4 : (ma_8 < ma_8[1] ? -4 : 0)
int score_13 = ma_13 > ma_13[1] ? 6 : (ma_13 < ma_13[1] ? -6 : 0)
int score_21 = ma_21 > ma_21[1] ? 8 : (ma_21 < ma_21[1] ? -8 : 0)
int score_34 = ma_34 > ma_34[1] ? 9 : (ma_34 < ma_34[1] ? -9 : 0)
int score_55 = ma_55 > ma_55[1] ? 10 : (ma_55 < ma_55[1] ? -10 : 0)
int score_89 = ma_89 > ma_89[1] ? 16 : (ma_89 < ma_89[1] ? -16 : 0)
int score_144 = ma_144 > ma_144[1] ? 20 : (ma_144 < ma_144[1] ? -20 : 0)
int score_233 = ma_233 > ma_233[1] ? 22 : (ma_233 < ma_233[1] ? -22 : 0)

int total_score = score_3 + score_5 + score_8 + score_13 + score_21 + score_34 + score_55 + score_89 + score_144 + score_233

// --- Candle Coloring ---
color candle_col = color.white
string trend_label = "Sem Tendência"
color trend_col = color.white

if total_score >= 81
    candle_col := color.blue
    trend_label := "Alta Forte"
    trend_col := color.blue
else if total_score >= 41
    candle_col := color.green
    trend_label := "Alta Média"
    trend_col := color.green
else if total_score >= 11
    candle_col := color.new(color.green, 50) // verde claro
    trend_label := "Alta Fraca"
    trend_col := color.new(color.green, 50)
else if total_score >= 0
    candle_col := color.white
    trend_label := "Sem Tendência"
    trend_col := color.white
else if total_score <= -81
    candle_col := color.yellow
    trend_label := "Baixa Forte"
    trend_col := color.yellow
else if total_score <= -41
    candle_col := color.red
    trend_label := "Baixa Média"
    trend_col := color.red
else if total_score <= -11
    candle_col := color.new(color.red, 50) // vermelha claro
    trend_label := "Baixa Fraca"
    trend_col := color.new(color.red, 50)
else
    candle_col := color.white
    trend_label := "Sem Tendência"
    trend_col := color.white

barcolor(candle_col)

// --- Dashboard ---
var table dash = table.new(position.bottom_right, 2, 2, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast and show_dashboard
    table.cell(dash, 0, 0, "Score MAs", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, str.tostring(total_score), text_color=total_score > 0 ? color.green : total_score < 0 ? color.red : color.white, text_size=size.small)
    table.cell(dash, 0, 1, "Status", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, trend_label, text_color=trend_col, text_size=size.small)
